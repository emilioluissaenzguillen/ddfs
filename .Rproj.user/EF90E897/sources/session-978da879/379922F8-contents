library(copula)

# Create a function to perform the IFM fitting for one group
fit_IFM_gaussian <- function(data_group, ddfs_X_group, ddfs_Z_group) {
  # Prepare the X-Z matrix
  dataXZ <- as.matrix(cbind(data_group$X, data_group$Z))

  # Kendall's tau and Gaussian rho
  kendall_tau <- cor(dataXZ, method = "kendall")[[2]]
  rho_gaussian <- sin(pi * kendall_tau / 2)

  # Get marginal CDFs from the GeDS fits
  F_X_new <- predict.ddfs(ddfs_X_group, newdata = data_group$X, type = "distribution")
  F_Z_new <- predict.ddfs(ddfs_Z_group, newdata = data_group$Z, type = "distribution")

  # Combine marginals
  F12 <- cbind(F_X_new, F_Z_new)

  # Fit Gaussian copula using IFM
  IFMfitn <- fitCopula(normalCopula(), F12, method = "ml", start = c(rho_gaussian))

  # Store results
  data.frame(
    rho_init = rho_gaussian,
    rho_est  = coef(IFMfitn),
    loglik   = logLik(IFMfitn)[[1]],
    kendall_tau_est = asin(IFMfitn@estimate) * 2 / pi
  )
}

# Apply to all three groups
