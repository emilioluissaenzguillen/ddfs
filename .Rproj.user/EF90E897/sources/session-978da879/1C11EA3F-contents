# Load ddfs
setwd("C:\\Users\\emili\\Dropbox\\Bayes Business School\\PhD\\Research\\PhD - Saenz, Emilio\\Projects\\PDF and CDF Estimation\\R package\\ddfs")
library(devtools)
document()
load_all()
library(nloptr)
library(numDeriv)

setwd("C:\\Users\\emili\\Dropbox\\Bayes Business School\\PhD\\Research\\PhD - Saenz, Emilio\\Projects\\PDF and CDF Estimation")

init_int.knt <- c(NA, "GeDS")
examples <- c("Gaussian", "Separated bimodal")

set.seed(123)

for (ex in examples) {
  sim <- sim.dist(N = 1000, ex = ex)
  X <- sim$X; f_X <- sim$f_X
  n = 4
  # Initialize vectors to store times
  time_ddfs_fit <- numeric(6)
  time_MLdens <- numeric(6)
  
  for (int.knt in init_int.knt) {
    par(mfrow = c(2,3))
    for (k in 1:6) {
      
      # Time ddfs_fit
      start <- Sys.time()
      ddfs_fit <- ddfs(X, n = n, min.intknots = k, max.intknots = k, beta = 0.2)
      end <- Sys.time()
      time_ddfs_fit[k] <- as.numeric(difftime(end, start, units = "secs"))
      
      # Time MLdens
      if (is.na(int.knt)) {
        start_int.knt = NULL
      } else {
        start_int.knt = get_internal_knots(ddfs_fit$f_X_hat$knots, n)
      }
      start <- Sys.time()
      MLdens <- dsplineML(X, n = n, k = k,
                          init_int.knt = start_int.knt,
                          init_theta = NULL, optm = "local")
      end <- Sys.time()
      time_MLdens[k] <- as.numeric(difftime(end, start, units = "secs"))
      
      # Plot
      plot(X, f_X, type = "l", ylab = "Density", xlab = "x", ylim = range(c(f_X,
                                                                            MLdens$pred,
                                                                            ddfs_fit$f_X_hat$pred)),
           lwd = 2, main = bquote(k == .(k)))
      lines(X, MLdens$pred, col = "purple", lwd = 2)
      lines(X, ddfs_fit$f_X_hat$pred, col = "red", lwd = 2)
      if (ex == "Gaussian") pos <- "topright" else pos <- "top"
      legend(pos,
             legend = c(bquote(f(x)),
                        bquote(hat(f)[MLE](x)),
                        bquote(hat(f)[DDFS](x))
             ),
             col = c("black", "purple", "red"),
             lwd = 2,
             bty = "n")
      for(knt in get_internal_knots(MLdens$knots, n)) {
        abline(v = knt, col = adjustcolor("purple", alpha.f = 0.5), lty = 2)
      }
      for(knt in get_internal_knots(ddfs_fit$f_X_hat$knots, n)) {
        abline(v = knt, col = adjustcolor("red", alpha.f = 0.5), lty = 2)
      }
    }
    
    # Print median times
    cat("Mean time for ddfs_fit:", mean(time_ddfs_fit), "seconds\n")
    cat("Mean time for MLdens:", mean(time_MLdens), "seconds\n")
    cat("ddfs_fit is ", mean(time_MLdens)/mean(time_ddfs_fit), " times faster.\n")
    
    dev.copy(png, filename = paste0("examples/figures/asymptotic_properties/", ex, int.knt, ".png"),
             width = 2700, height = 1800, res = 300)
    
    dev.off()
    
  }
  
}



