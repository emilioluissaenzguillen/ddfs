# If `i_star == 1`, set `cdf_prev` to the same row as `cdf_current` since  F_0(x|z_0) = F_1(x|z_1)
cdf_prev_indices <- ifelse(i_star == 1, i_star, i_star - 1)
cdf_current_indices <- i_star

# Calculate the weight w
w <- Z_new - (i_star - 1)

# Compute \tilde{x}|z for each \hat{\tilde{F}}_{i^*-1,n}(x|z_{i^*-1})
# and \hat{\tilde{F}}_{i^*,n}(x|z_{i^*})
generate_X_tilde <- function(v, cdf_indices, ddfs_X_tilde_cond) {
  # Generate a random value u
  u <- runif(v)

  # Compute X_tilde
  sapply(seq_len(v), function(i) {
    # Select \hat{\tilde{F}}_{i^*-1,n}(x|z_{i^*-1}) or \hat{\tilde{F}}_{i^*,n}(x|z_{i^*})
    perc_inc_cond <- ddfs_X_tilde_cond[[cdf_indices[i]]]

    # (i) Piecewise polynomial representation
    ppoly_cubicX <- PPolyRep(perc_inc_cond$F_X_hat, n = perc_inc_cond$F_X_hat$order)

    # (ii) Invert quadratic polynomial
    inv_PPolyGeDS(ppoly_cubicX, u[i])
  })
}

X_tilde_prev <- generate_X_tilde(v, cdf_prev_indices, ddfs_X_tilde_cond)
X_tilde_current <- generate_X_tilde(v, cdf_current_indices, ddfs_X_tilde_cond)

# Simulate binomial variable
z <- rbinom(v, size = 1, prob = w)

# Compute \tilde{x}|z from the mixed cdf \tilde{F}(x|z)
X_tilde <- (1 - z) * X_tilde_prev + z * X_tilde_current

