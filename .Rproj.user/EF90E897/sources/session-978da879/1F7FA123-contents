################### Method of inference function for margins ###################
################################################################################
dataXZ <- as.matrix(cbind(data$X, data$Z))
kendall_tau <- cor(dataXZ, method = "kendall")[[2]]
rho_gaussian <- sin(pi*kendall_tau/2)

X_new <- data[,1]
Z_new <- data[,2]

F_X_new <- predict.ddfs(ddfs_X, newdata = X_new, type = "distribution")
# # Replace values in F_X_new that are close to 0 or 1
# F_X_new <- ifelse(abs(F_X_new - 0) < 1e-3, 0,
#                   ifelse(abs(F_X_new - 1) < 1e-3, 1, F_X_new))
F_Z_new <- predict.ddfs(ddfs_Z, newdata = Z_new, type = "distribution")
# # Replace values in F_X_new that are close to 0 or 1
# F_Z_new <- ifelse(abs(F_Z_new - 0) < 1e-3, 0,
#                   ifelse(abs(F_Z_new - 1) < 1e-3, 1, F_Z_new))

# Prepare marginal cdfs
F1 = F_X_new
F2 = F_Z_new
F12 = cbind(F1, F2)

# Fit meta distribution based on IFM
IFMfitn <- fitCopula(normalCopula(), F12, method="ml",
                     start = c(rho_gaussian))
# Pad each vector to the maximum length and combine them
IFM_fits <- cbind(coef(IFMfitn), logLik(IFMfitn)[[1]])

# Name the rows and columns
row.names(IFM_fits) <- c("Gaussian")
colnames(IFM_fits) <- c("rho", "loglikelihood")

print(IFM_fits)

# Kendall's tau
kendall_tau <- asin(IFMfitn@estimate)*2/pi

# Save the list object as an RDS file
