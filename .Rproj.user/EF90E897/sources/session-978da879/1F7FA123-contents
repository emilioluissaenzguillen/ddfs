################################################################################
########################### Empirical Copula X and Z ###########################
################################################################################
rank1 <- rank(data$X)
rank2 <- rank(data$Z)
copula_u1u2 <- list()
u1 <- unlist(list())
u2 <- unlist(list())
for (i in 1:10000){
  u1[i] <- runif(1)
  u2[i] <- runif(1)
  indicator <- list()
  for (j in 1:length(data$X)){
    indicator[j] <- as.numeric(rank1[j]/(length(data$X)+1) <= u1[i] &
                                 rank2[j]/(length(data$Z)+1) <= u2[i])
  }
  copula_u1u2[i] <- (1/length(data$X)) * sum(unlist(indicator))
}

copula_n_u1u2 <- unlist(copula_u1u2)

copula <- data.frame(u1, u2, copula_n_u1u2)

pdf(paste0(output,"\\empirical_copula.pdf"), width=9.33, height=9.33)
