# Explicit inversion of the GeDS CDF fits
u_values <- seq(0, 1, length.out = 1000)
# Compute the Lorenz curve for these values
inv_F_X <- function(u) {
  return(inv_PPolyGeDS(ppoly_cubicX, u))
}
inv_F_Z <- function(u) {
  return(inv_PPolyGeDS(ppoly_cubicZ, u))
}
L_n_values_X <- lorenz_curve(u = u_values, inverse_F_X = function(u) q.ddfs(ddfs_fit_X, u))
L_n_values_Z <- lorenz_curve(u = u_values, inverse_F_X = function(u) q.ddfs(ddfs_fit_Z, u))

lorenz_df_X <- data.frame(u = u_values, L_u = L_n_values_X)
lorenz_df_Z <- data.frame(u = u_values, L_u = L_n_values_Z)

# X tilde
load("lorenz_curves&copula\\rds\\lorenz_df_X_tilde.RData")

