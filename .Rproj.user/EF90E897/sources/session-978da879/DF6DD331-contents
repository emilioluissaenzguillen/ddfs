## 2. Find the index r
r_values <- mapply(function(x_vec, mids) {
  findInterval(
    x_vec,
    vec = c(min(breaks_inc), mids, max(breaks_inc)),
    rightmost.closed = TRUE
  ) - 1
}, x_vec = X_new, mids = midpoints_inc, SIMPLIFY = FALSE)


## 3. Compute F(z|x)
# If `r == 1`, set `cdf_prev` to the same row as `cdf_current` since  F_0(x|z_0) = F_1(x|z_1)
cdf_indices <- mapply(function(r, mids) {
  list(
    r_index     = ifelse(r == 0, r + 1, r),
    r_plus1_idx = ifelse(r == length(mids), r, r + 1)
  )
}, r = r_values, mids = midpoints_inc, SIMPLIFY = FALSE)

cdf_r_indices         <- lapply(cdf_indices, `[[`, "r_index")
cdf_r_plus_1_indices   <- lapply(cdf_indices, `[[`, "r_plus1_idx")

# Extract `cdf_prev` and `cdf_current` using matrix subsetting
cdf_r <- lapply(names(cdf_r_indices), function(name) {
  lapply(cdf_r_indices[[name]], function(i) cdf_list[[name]][[i]])
})
names(cdf_r) <- names(cdf_r_indices)

cdf_r_plus_1 <- lapply(names(cdf_r_plus_1_indices), function(name) {
  lapply(cdf_r_plus_1_indices[[name]], function(i) cdf_list[[name]][[i]])
})
names(cdf_r_plus_1) <- names(cdf_r_plus_1_indices)

# Calculate the weight w
w <- lapply(names(X_new), function(name) {
  (X_new[[name]] - midpoints_inc[[name]][cdf_r_indices[[name]]]) /
    (midpoints_inc[[name]][cdf_r_plus_1_indices[[name]]] - midpoints_inc[[name]][cdf_r_indices[[name]]])
})
names(w) <- names(X_new)

# Simulate binomial variable
z <- lapply(names(w), function(name) {
  # set.seed(123)
  n <- length(w[[name]])
  rbinom(n, size = 1, prob = w[[name]])
})
names(z) <- names(w)

# Compute the mixed cdf F(z|x)
mixed_cdf <- lapply(names(w), function(name) {
  mapply(function(w_i, cdf_r, cdf_r_plus_1) {
    (1 - w_i) * cdf_r[["F_r_n"]] + w_i * cdf_r_plus_1[["F_r_n"]]
  },
  z[[name]], cdf_r[[name]], cdf_r_plus_1[[name]], SIMPLIFY = FALSE)
})
names(mixed_cdf) <- names(z)

mixed_cdf$richer[[1]]

## 4. Generate a variate z|x
Z_new <- lapply(names(mixed_cdf), function(group) {
  unlist(lapply(mixed_cdf[[group]], function(F_X) {
    df <- data.frame(X = sort(data[[group]]$Z), F_X = F_X)
    u <- runif(1)
    inverse_F_X(u, df = df)
  }))
})

