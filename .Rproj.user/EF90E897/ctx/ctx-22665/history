mixed_cdf <- Map(function(w_i, cdf_r, cdf_r_plus_1) {
(1 - w_i) * cdf_r[["F_r_n"]] + w_i * cdf_r_plus_1[["F_r_n"]]
}, w, cdf_r, cdf_r_plus_1)
mixed_cdf
mixed_cdf <- Map(function(w_i, cdf_r, cdf_r_plus_1) {
# Extract all F_r_n vectors from the sublists
F_r_vecs  <- lapply(cdf_r, \(x) x[["F_r_n"]])
F_r1_vecs <- lapply(cdf_r_plus_1, \(x) x[["F_r_n"]])
# Each element of F_r_vecs corresponds to one observation’s CDF vector
# Combine elementwise with w_i
mapply(function(w_val, Fr, Fr1) (1 - w_val) * Fr + w_val * Fr1,
w_i, F_r_vecs, F_r1_vecs, SIMPLIFY = FALSE)
}, w, cdf_r, cdf_r_plus_1)
mixed_cdf
