#############################################################################
## (a) Use the DDFS fit \hat{F}_X(x), to generate a real income variate, x ##
#############################################################################
## 1. Get the DDFS fit of the ecdf of X
# debugonce(UnivariateDensityFitter)
ddfs_X <- ddfs(sort(data$X), n = 3, phi_F = 0.4, q_F = 2, plot = TRUE)
# Save the list object as an RDS file
saveRDS(ddfs_X, file = paste0("lorenz_curves&copula/rds/X/ddfs_X", suffix, ".rds"))
## 2. Generate a real income variate, x
set.seed(123)
n <- NROW(data_study)
X_new <- r.ddfs(ddfs_X, n)
############################################################################
## (b)/(c) Find the index r. Generate a variate z|x, using the cdf F(z|x) ##
############################################################################
## 1. Compute F_{r,n}
# Define the r levels of X
x_levels <- sort(unique(data$X))
cdf_list <- list()
# Loop through each level of X
for (r in x_levels) {
# Subset data for the current level of X
subset_data <- data[data$X == r, ]
# Calculate m_r, the number of observations for the current level of X
m_r <- nrow(subset_data)
# Initialize a vector to store CDF values for the current X level
cdf_values <- numeric(length(data$Z))
# Loop through each z value and calculate the empirical CDF
for (j in seq_along(data$Z)) {
z <- data$Z[j]
# Calculate the proportion of Z values <= z within the subset
cdf_values[j] <- sum(subset_data$Z <= z) / m_r
}
# Store the result as a data frame in the list for the current level of X
data_cdf <- data.frame(Z = data$Z, F_r_n = cdf_values)
cdf_list[[as.character(r)]] <- data_cdf[order(data_cdf$Z),]
}
# View the result for a particular level
print(cdf_list[["82500"]])
## 2. Find the index r
r <- findInterval(X_new, c(min(breaks_inc), midpoints_inc, max(breaks_inc)) ) - 1
## 3. Compute F(z|x)
# If `r == 1`, set `cdf_prev` to the same row as `cdf_current` since  F_0(x|z_0) = F_1(x|z_1)
cdf_r_indices <- ifelse(r == 0, r + 1, r)
cdf_r_plus_1_indices <- ifelse(r == length(midpoints_inc), r, r + 1)
