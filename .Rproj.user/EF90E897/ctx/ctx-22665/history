w <- lapply(names(X_new), function(name) {
(X_new[[name]] - midpoints_inc[[name]][cdf_indices[[name]]$r_index]) /
(midpoints_inc[[name]][cdf_indices[[name]]$r_plus1_index] - midpoints_inc[[name]][cdf_indices[[name]]$r_index])
})
names(w) <- names(X_new)
w
