#############################################################################
## (a) Use the DDFS fit \hat{F}_X(x), to generate a real income variate, x ##
#############################################################################
## 1. Get the DDFS fit of the ecdf of X
ddfs_X <- lapply(data, function(df) {
d <- ddfs(sort(df$X), n = 4, phi_F = 0.8, q_F = 2)
plot(d, type = "distribution")
return(d)
})
# Save the list object as an RDS file
saveRDS(ddfs_X, file = paste0("lorenz_curves&copula/rds/X/ddfs_X.rds"))
## 2. Generate a real income variate, x
set.seed(123)
X_new <- mapply(
function(obj, df) r.ddfs(obj, NROW(df)),
obj = ddfs_X,
df = data_study,
SIMPLIFY = FALSE
)
############################################################################
## (b)/(c) Find the index r. Generate a variate z|x, using the cdf F(z|x) ##
############################################################################
## 1. Compute F_{r,n}
cdf_list_all <- lapply(data, function(df) {
X_levels <- sort(unique(df$X))
# Initialize list to store CDFs for this dataset (e.g. for base/poorer/richer)
cdf_list <- list()
for (x_r in X_levels) {
# Subset data for the current level of X
subset_data <- df[df$X == x_r, ]
# Calculate m_r, the number of observations for the current level of X
m_r <- nrow(subset_data)
# Calculate empirical CDF at each z in df$Z
cdf_values <- sapply(df$Z, function(z) sum(subset_data$Z <= z) / m_r)
data_cdf <- data.frame(Z = df$Z, F_r_n = cdf_values)
cdf_list[[as.character(x_r)]] <- data_cdf[order(data_cdf$Z), ]
}
return(cdf_list)
})
# View the result for a particular level
tail(cdf_list_all$base[["67500"]], 20)
tail(cdf_list_all$poorer[["10000"]], 20)
tail(cdf_list_all$richer[["82500"]], 20)
## 2. Find the index r
r_values <- mapply(function(x_vec, mids) {
findInterval(
x_vec,
vec = c(min(breaks_inc), mids, max(breaks_inc)),
rightmost.closed = TRUE
) - 1
}, x_vec = X_new, mids = midpoints_inc, SIMPLIFY = FALSE)
## 3. Compute F(z|x)
# If `r == 1`, set `cdf_prev` to the same row as `cdf_current` since  F_0(x|z_0) = F_1(x|z_1)
cdf_indices <- mapply(function(r, mids) {
list(
r_index     = ifelse(r == 0, r + 1, r),
r_plus1_idx = ifelse(r == length(mids), r, r + 1)
)
}, r = r_values, mids = midpoints_inc, SIMPLIFY = FALSE)
cdf_r_indices         <- lapply(cdf_indices, `[[`, "r_index")
cdf_r_plus_1_indices   <- lapply(cdf_indices, `[[`, "r_plus1_idx")
# Extract `cdf_prev` and `cdf_current` using matrix subsetting
cdf_r <- lapply(names(cdf_r_indices), function(name) {
lapply(cdf_r_indices[[name]], function(i) cdf_list[[i]])
})
names(cdf_r) <- names(cdf_r_indices)
