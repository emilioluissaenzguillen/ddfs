cdf_r_indices[[name]]
cdf_r <- lapply(names(cdf_r_indices), function(name) {
lapply(cdf_r_indices[[name]], function(i) cdf_list[[name]][[i]])
})
names(cdf_r) <- names(cdf_r_indices)
# Extract `cdf_prev` and `cdf_current` using matrix subsetting
cdf_r <- lapply(names(cdf_r_indices), function(name) {
lapply(cdf_r_indices[[name]], function(i) cdf_list[[name]][[i]])
})
names(cdf_r) <- names(cdf_r_indices)
cdf_r_plus_1 <- lapply(names(cdf_r_plus_1_indices), function(name) {
lapply(cdf_r_plus_1_indices[[name]], function(i) cdf_list[[name]][[i]])
})
names(cdf_r_plus_1) <- names(cdf_r_plus_1_indices)
# Calculate the weight w
w <- lapply(names(X_new), function(name) {
(X_new[[name]] - midpoints_inc[[name]][cdf_r_indices[[name]]]) /
(midpoints_inc[[name]][cdf_r_plus_1_indices[[name]]] - midpoints_inc[[name]][cdf_r_indices[[name]]])
})
names(w) <- names(X_new)
# Simulate binomial variable
z <- lapply(names(w), function(name) {
n <- length(w[[name]])
rbinom(n, size = 1, prob = w[[name]])
})
names(z) <- names(w)
# Compute the mixed cdf F(z|x)
mixed_cdf <- Map(function(w_i, cdf_r, cdf_r_plus_1) {
(1 - w_i) * cdf_r[["F_r_n"]] + w_i * cdf_r_plus_1[["F_r_n"]]
}, w, cdf_r, cdf_r_plus_1)
Z_new <- lapply(names(mixed_cdf), function(name) {
F_X <- mixed_cdf[[name]]
# Create the data frame for each element in mixed_cdf
df <- data.frame(X = sort(data[[name]]$Z), F_X = F_X)
# Generate a random value u
u <- runif(1)
# Apply inverse_F_X to find the interval or value based on u
inverse_F_X(u, df = df)
})
names(Z_new) <- names(mixed_cdf)
Z_new <- lapply(names(mixed_cdf), function(name) {
F_X <- mixed_cdf[[name]]
df <- data.frame(X = sort(data[[name]]$Z), F_X = F_X)
# Generate a random value u
u <- runif(1)
# Apply inverse_F_X to find the interval or value based on u
inverse_F_X(u, df = df)
})
