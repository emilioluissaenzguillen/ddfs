# Calculate m_r, the number of observations for the current level of X
m_r <- nrow(subset_data)
# Calculate empirical CDF at each z in df$Z
cdf_values <- sapply(df$Z, function(z) sum(subset_data$Z <= z) / m_r)
data_cdf <- data.frame(Z = df$Z, F_r_n = cdf_values)
