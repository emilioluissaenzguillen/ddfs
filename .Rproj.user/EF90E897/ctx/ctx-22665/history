# Helper to build (X,Z) dataset for one subset
build_sample <- function(df, income_brackets) {
indices <- which(income_brackets %in% unique(df$income))
breaks_sel <- breaks_inc[unique(c(indices, indices + 1))]
inc_brackets_sel <- income_brackets[indices]
# Midpoints of ranges
midpoints_inc <- (breaks_sel[-length(breaks_sel)] + breaks_sel[-1]) / 2
names(midpoints_inc) <- inc_brackets_sel
X <- midpoints_inc[df$income]
sample_df <- data.frame(X = X, Z = df$Z)
return(list(sample = sample_df, midpoints = midpoints_inc))
}
# Create another list with the (X,Z) samples
res           <- lapply(data_study, build_sample, income_brackets = income_brackets)
data          <- lapply(res, `[[`, "sample")
midpoints_inc <- lapply(res, `[[`, "midpoints")
################################################################################
###################### Step 1: Recover Income (X) sample  ######################
