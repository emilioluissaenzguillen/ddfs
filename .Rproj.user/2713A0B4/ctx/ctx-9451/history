# Function to process each dataset: filter, sort, and select relevant columns
process_data <- function(data, beta = NULL, phi_F = NULL, q_F = NULL,
min.intknots = NULL) {
if (!is.null(beta)) {
data <- data[data$beta == beta, ]
}
if (!is.null(phi_F)) {
data <- data[data$phi_F == phi_F, ]
}
if (!is.null(q_F)) {
data <- data[data$q_F == q_F, ]
}
if (!is.null(min.intknots)) {
# If a vector is provided, use %in%, otherwise just ==
if (length(min.intknots) > 1) {
data <- data[data$min.intknots %in% min.intknots, ]
} else {
data <- data[data$min.intknots == min.intknots, ]
}
}
data <- data[order(data$Q3, na.last = TRUE), ]
data <- data[, c("n", "min.intknots", "phi_F", "q_F", "beta", "Q1", "Q2", "Q3")]
return(data)
}
c("Gaussian", "Student-t", "Kurtotic unimodal", "Skewed unimodal",
"Strongly skewed", "Outlier", "Gamma", "Nakagami")
