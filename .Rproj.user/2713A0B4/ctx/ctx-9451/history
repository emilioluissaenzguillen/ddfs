models_to_run = c("DDFS", "kernel")
Ns <- c(10^5)
output_labels <- c("output\\N=1000", "output\\N=100")
examples <- c("Gaussian", "Student-t", "Kurtotic unimodal", "Skewed unimodal",
"Strongly skewed", "Outlier", "Gamma", "Smooth comb", "Bimodal",
"Separated bimodal", "Skewed bimodal", "Trimodal", "Claw", "Nakagami",
"Generalized extreme value", "Log-normal", "Weibull", "Chi-square")
examples <- c("Gaussian")
ex = "Gaussian"
N = 100000
run_models <- function(i, models_to_run = c("DDFS", "kernel", "logspline", "lpdensity")) {
sim <- zhenyucui_examples(N, ex)
X <- sim$X; f_X <- sim$f_X; F_X <- sim$F_X
X_new <- seq(from = min(X), to = max(X), length.out = 1000)
result <- list(
# DDFS
MSE_DDFS_pdf = NULL, setMAE_DDFS_pdf = NULL, n_intknots_DDFS = NULL, time_DDFS = NULL, f_hat_DDFS = NULL, f_pred_DDFS = NULL,
MSE_DDFS_cdf = NULL, MAE_DDFS_cdf = NULL, F_hat_DDFS = NULL, F_pred_DDFS = NULL,
# kernel
MSE_kernel_pdf = NULL, MAE_kernel_pdf = NULL, n_intknots_kernel = NULL, time_kernel = NULL, f_hat_kernel = NULL, f_pred_kernel = NULL,
MSE_kernel_cdf = NULL, MAE_kernel_cdf = NULL, F_hat_kernel = NULL, F_pred_kernel = NULL,
# logspline
MSE_logspline_pdf = NULL, MAE_logspline_pdf = NULL, n_intknots_logspline = NULL, time_logspline = NULL, f_hat_logspline = NULL, f_pred_logspline = NULL,
MSE_logspline_cdf = NULL, MAE_logspline_cdf = NULL, F_hat_logspline = NULL, F_pred_logspline = NULL,
# lpdensity
MSE_lpdensity_pdf = NULL, MAE_lpdensity_pdf = NULL, n_intknots_lpdensity = NULL, time_lpdensity = NULL, f_hat_lpdensity = NULL, f_pred_lpdensity = NULL,
MSE_lpdensity_cdf = NULL, MAE_lpdensity_cdf = NULL, F_hat_lpdensity = NULL, F_pred_lpdensity = NULL
)
# T: min.intknots = 4 else min.intknots = 6 phi_F = 0.4, q_F = 2, beta = 0
# Kurtotic unimod: min.intknots = 10 else min.intknots = 12, phi_F = 0.4, q_F = 2, beta = 0.7
# Skewed unimodal: min.intknots = 4 else min.intknots = 6 phi_F = 0.4, q_F = 2, beta = 0
# Strongly skewed: min.intknots = 10 else min.intknots = 12, phi_F = 0.4, q_F = 2, beta = 0.7
# Oulier: min.intknots = 8 else min.intknots = 10 phi_F = 0.4, q_F = 2, beta = 0.7
# Gamma : min.intknots = 2 else min.intknots = 5 phi_F = 0.4, q_F = 2, beta = 0
# Smooth comb: min.intknots = 8 else min.intknots = 14 phi_F = 0.995, q_F = 4, beta = 0
# Bimodal min.intknots = 10 else min.intknots = 16 phi_F = 0.9, q_F = 2, beta = 0.9
# Separated bimodal n = 5 min.intknots = 4 else min.intknots = 6 phi_F = 0.95, q_F = 2, beta = 0
# Skewed bimodal n = 5, min.intknots = 4 else min.intknots = 8, phi_F = 0.95, q_F = 2, beta = 0
# Trimodal n = 4, min.intknots = 10 else min.intknots = 16, phi_F = 0.99, q_F = 2, beta = 0.7
# Claw min.intknots = 12 else min.intknots = 18, phi_F = 0.995, q_F = 2, beta = 0
# Nakagami: min.intknots = 3 else min.intknots = 5, phi_F = 0.1, q_F = 2, beta = 0
# Generalized extreme value: min.intknots = 1 else min.intknots = 4, phi_F = 0.3, q_F = 1, beta = 0.7
# Log-normal: min.intknots = 2 else min.intknots = 4, phi_F = 0.4, q_F = 2, beta = 0.7
# Weibull: min.intknots = 4 else min.intknots = 6 phi_F = 0.4, q_F = 2, beta = 0
# Chi-square min.intknots = 2 else min.intknots = 4 phi_F = 0.4, q_F = 2, beta = 0
# (I) DDFS
if ("DDFS" %in% models_to_run) {
if (suppressMessages(suppressWarnings(dip.test(X)$p.value)) >= 0.3) {
if (N == 100) min.intknots = 2 else min.intknots = 4
} else {
if (N == 100) min.intknots = 10 else min.intknots = 16
}
start_time <- Sys.time()
GmodDens <- tryCatch(
ddfs(X, n = 4, min.intknots = 8, phi_F = 0.4, q_F = 1, beta = 0),
error = function(e) {
message(paste0("Error occurred in DDFS for iteration = ", i, ": ", e))
return(NULL)
}
)
sim <- zhenyucui_examples(N, ex)
X <- sim$X; f_X <- sim$f_X; F_X <- sim$F_X
kurtosis(X)
# mod <- ddfs(X, n = 4, min.intknots = 8, phi_F = 0.95, q_F = 2, beta = 0.7)
# plot.ddfs(mod, type = "density", f = sim$f_X_func)
# length(GeDS:::get_internal_knots(mod$f_X_hat$knots,4))
if(!is.null(GmodDens)){
# PDF
f_hat_DDFS <- GmodDens$f_X_hat$pred
result$f_hat_DDFS <- f_hat_DDFS
result$MSE_DDFS_pdf <- mean((f_X - f_hat_DDFS)^2)
result$MAE_DDFS_pdf <- mean(abs(f_X - f_hat_DDFS))
result$n_intknots_DDFS <- length(GmodDens$f_X_hat$knots) - GmodDens$f_X_hat$order*2
result$f_pred_DDFS <- as.numeric(predict.ddfs(GmodDens, newdata = X_new, type = "density"))
# CDF
F_hat_DDFS <- GmodDens$F_X_hat$pred
result$F_hat_DDFS <- F_hat_DDFS
result$MSE_DDFS_cdf <- mean((F_X - F_hat_DDFS)^2)
result$MAE_DDFS_cdf <- mean(abs(F_X - F_hat_DDFS))
result$F_pred_DDFS <- as.numeric(predict.ddfs(GmodDens, newdata = X_new, type = "distribution"))
}
end_time <- Sys.time()
result$time_DDFS <- difftime(end_time, start_time, units = "secs")
}
# (II) kernel
if ("kernel" %in% models_to_run) {
start_time <- Sys.time()
kernel_fit <- tryCatch(
density(X, bw = "SJ", kernel = "optcosine"),
error = function(e) {
message(paste0("Error occurred in kernel for iteration = ", i, ": ", e))
return(NULL)
}
)
if(!is.null(kernel_fit)){
# PDF
f_hat_kernel <- approx(x = kernel_fit$x, y = kernel_fit$y, xout = X)$y
result$f_hat_kernel <- f_hat_kernel
result$MSE_kernel_pdf <- mean((f_X - f_hat_kernel)^2)
result$MAE_kernel_pdf <- mean(abs(f_X - f_hat_kernel))
result$f_pred_kernel <- as.numeric(approx(x = kernel_fit$x, y = kernel_fit$y, xout = X_new)$y)
# CDF
kernelCDF <- CDF(kernel_fit)
F_hat_kernel <- kernelCDF(X)
result$F_hat_kernel <- F_hat_kernel
result$MSE_kernel_cdf <- mean((F_X - F_hat_kernel)^2)
result$MAE_kernel_cdf <- mean(abs(F_X - F_hat_kernel))
result$F_pred_kernel <- kernelCDF(X_new)
}
end_time <- Sys.time()
result$time_kernel <- difftime(end_time, start_time, units = "secs")
}
# (III) logspline
if ("logspline" %in% models_to_run) {
start_time <- Sys.time()
logspline_fit <- tryCatch(
logspline(X),
error = function(e) {
message(paste0("Error occurred in logspline for iteration = ", i, ": ", e))
return(NULL)
}
)
if(!is.null(logspline_fit)){
# PDF
f_hat_logspline <- dlogspline(X, logspline_fit)
result$f_hat_logspline <- f_hat_logspline
result$MSE_logspline_pdf <- mean((f_X - f_hat_logspline)^2)
result$MAE_logspline_pdf <- mean(abs(f_X - f_hat_logspline))
result$f_pred_logspline <- as.numeric(dlogspline(X_new, logspline_fit))
# CDF
F_hat_logspline <- plogspline(X, logspline_fit)
result$F_hat_logspline <- F_hat_logspline
result$MSE_logspline_cdf <- mean((F_X - F_hat_logspline)^2)
result$MAE_logspline_cdf <- mean(abs(F_X - F_hat_logspline))
result$F_pred_logspline <- as.numeric(plogspline(X_new, logspline_fit))
}
end_time <- Sys.time()
result$time_logspline <- difftime(end_time, start_time, units = "secs")
}
# (IV) lpdensity
if ("lpdensity" %in% models_to_run) {
start_time <- Sys.time()
lpdensity_fit <- tryCatch(
lpdensity(data = X, grid = X,  bwselect = "imse-dpi"),
error = function(e) {
message(paste0("Error occurred in lpdensity for iteration = ", i, ": ", e))
return(NULL)
}
)
if(!is.null(lpdensity_fit)){
# PDF
f_hat_lpdensity <- as.numeric(lpdensity_fit$Estimate[, "f_p"])
result$f_hat_lpdensity <- f_hat_lpdensity
result$MSE_lpdensity_pdf <- mean((f_X - f_hat_lpdensity)^2)
result$MAE_lpdensity_pdf <- mean(abs(f_X - f_hat_lpdensity))
result$f_pred_lpdensity <- as.numeric(lpdensity(data = X, grid = X_new,  bwselect = "imse-dpi")$Estimate[,"f_p"])
# CDF
F_hat_lpdensity <- as.numeric(lpdensity(data = X, grid = X, v = 0, bwselect = "imse-dpi")$Estimate[,"f_p"])
result$F_hat_lpdensity <- F_hat_lpdensity
result$MSE_lpdensity_cdf <- mean((F_X - F_hat_lpdensity)^2)
result$MAE_lpdensity_cdf <- mean(abs(F_X - F_hat_lpdensity))
result$F_pred_lpdensity <- as.numeric(lpdensity(data = X, grid = X_new, v = 0, bwselect = "imse-dpi")$Estimate[,"f_p"])
}
end_time <- Sys.time()
result$time_lpdensity <- difftime(end_time, start_time, units = "secs")
}
return(result)
}
runs <- 100
# Set a seed for reproducibility
set.seed(123)
runs <- 1
results <- lapply(1:runs, function(i) run_models(i, models_to_run))
MSE_DDFS_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$MSE_DDFS_pdf)) res$MSE_DDFS_pdf else NA
)
MSE_DDFS_pdf
MSE_kernel_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$MSE_kernel_pdf)) res$MSE_kernel_pdf else NA
)
MSE_kernel_pdf
