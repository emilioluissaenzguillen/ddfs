source("scripts\\utils.R")
setwd("C:\\Users\\addj700\\Dropbox\\Bayes Business School\\PhD\\Research\\PhD - Saenz, Emilio\\Projects\\PDF and CDF Estimation\\examples\\simulation_univariate\\Kirkby et al\\Zhenyu Cui et al. (2020)")
################################################################################
# Cui Z, Kirkby JL, Nguyen D.
# NONPARAMETRIC DENSITY ESTIMATION BY B-SPLINE DUALITY.
# Econometric Theory. 2020;36(2):250-291. doi:10.1017/S0266466619000112
# TABLE 2. Test case densities for numerical experiments
