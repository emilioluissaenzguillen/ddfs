    )
    MAE_lpdensity_pdf <- sapply(results, function(res)
      if(!is.null(res) && !is.null(res$MAE_lpdensity_pdf)) res$MAE_lpdensity_pdf else NA
    )
    MISE_lpdensity_pdf <- sapply(results, function(res)
      if(!is.null(res) && !is.null(res$MISE_lpdensity_pdf)) res$MISE_lpdensity_pdf else NA
