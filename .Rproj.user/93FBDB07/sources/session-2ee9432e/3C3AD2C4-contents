models_to_run = c("DDFS")
Ns <- c(10^2, 10^3, 10^4)
output_labels <- c("output/N=100", "output/N=1000", "output/N=10000")
examples <- c("Gaussian", "Student-t", "Exponential", "Chi-square", "Gamma", "Weibull",
              "Log-normal", "Nakagami", "Kurtotic unimodal", "Outlier", "Skewed unimodal",
              "Strongly skewed", "Merton's jump diffusion", "Kou's double exponential",
              "GEV Type I", "GEV Type II", "GEV Type III",
              "MixGauss", "Mix1d", "MixGauss2", "MixGauss3",
              "Bimodal", "Separated bimodal", "Skewed bimodal",
              "Trimodal", "Smooth comb", "Claw")

Ns <- c(10^5)
output_labels <- c("output/N=100000")
examples <- examples[19:27]


for (ex in examples) {
  for (i in seq_along(Ns)) {
    N <- Ns[i]
    output <- output_labels[i]

    run_models <- function(i, models_to_run = c("DDFS", "kernel", "logspline", "lpdensity")) {

      sim <- sim.dist(N, ex)
      X <- sim$X; f_X <- sim$f_X; F_X <- sim$F_X

      X_new <- seq(from = min(X), to = max(X), length.out = 1000)
      f_X_new <- sim$f_X_func(X_new)

      result <- list(
        # DDFS
        MSE_DDFS_pdf = NULL, MAE_DDFS_pdf = NULL, MISE_DDFS_pdf = NULL, MIAE_DDFS_pdf = NULL,
        n_intknots_DDFS = NULL, roughness_DDFS_pdf = NULL,
        time_DDFS = NULL, f_hat_DDFS = NULL, f_pred_DDFS = NULL,
        MSE_DDFS_cdf = NULL, MAE_DDFS_cdf = NULL, F_hat_DDFS = NULL, F_pred_DDFS = NULL,
        roughness_DDFS_cdf = NULL,
        # kernel
        MSE_kernel_pdf = NULL, MAE_kernel_pdf = NULL, MISE_kernel_pdf = NULL, MIAE_kernel_pdf = NULL,
        n_intknots_kernel = NULL, roughness_kernel_pdf = NULL,
        time_kernel = NULL, f_hat_kernel = NULL, f_pred_kernel = NULL,
        MSE_kernel_cdf = NULL, MAE_kernel_cdf = NULL, F_hat_kernel = NULL, F_pred_kernel = NULL,
        roughness_kernel_cdf = NULL,
        # logspline
        MSE_logspline_pdf = NULL, MAE_logspline_pdf = NULL, MISE_logspline_pdf = NULL, MIAE_logspline_pdf = NULL,
        n_intknots_logspline = NULL, roughness_logspline_pdf = NULL,
        time_logspline = NULL, f_hat_logspline = NULL, f_pred_logspline = NULL,
        MSE_logspline_cdf = NULL, MAE_logspline_cdf = NULL, F_hat_logspline = NULL, F_pred_logspline = NULL,
        roughness_logspline_cdf = NULL,
        # lpdensity
        MSE_lpdensity_pdf = NULL, MAE_lpdensity_pdf = NULL, MISE_lpdensity_pdf = NULL, MIAE_lpdensity_pdf = NULL,
        n_intknots_lpdensity = NULL, roughness_lpdensity_pdf = NULL,
        time_lpdensity = NULL, f_hat_lpdensity = NULL, f_pred_lpdensity = NULL,
        MSE_lpdensity_cdf = NULL, MAE_lpdensity_cdf = NULL, F_hat_lpdensity = NULL, F_pred_lpdensity = NULL,
        roughness_lpdensity_cdf = NULL
      )

      # (I) DDFS
      if ("DDFS" %in% models_to_run) {

        # if (suppressMessages(suppressWarnings(dip.test(X)$p.value)) >= 0.3) {
        #   if (N == 100) min.intknots = 3 else min.intknots = 6
        #   } else {
        #     if (N == 100) min.intknots = 6 else min.intknots = 8
        #   }

        # # Define beta based on data kurtosis
        # if (N == 1000) {
        #
        #   if (abs(kurtosis(X) - 3) > 2.5) {
        #     beta = 0.9
        #
        #     } else if (abs(kurtosis(X) - 3) > 1.5) {
        #       beta = 0.6
        #       if (abs(skewness(X)) > 0.5) beta = 0.8
        #
        #       } else if (abs(kurtosis(X) - 3) > 0.5) {
        #         beta = 0.2
        #
        #         } else {
        #           beta = 0
        #         }
        #
        #   } else if (N == 100) {
        #     beta = 0
        #     if (abs(kurtosis(X) - 3) > 0.5 && abs(skewness(X)) > 0.5) beta = 0.4
        #     if (abs(kurtosis(X) - 3) > 2.5) beta = 0.2
        #   }

        #----------------------------------------------------------------------#
        #----------------------------------------------------------------------#
        #----------------------------------------------------------------------#

        params <- get_params(ex, N, minimize = "MISE")


        start_time <- Sys.time()
        GmodDens <- tryCatch(
          ddfs(X, n = 4, min.intknots = params$min.intknots, phi_F = params$phi_F,
               q_F = params$q_F, beta = params$beta),
          error = function(e) {
            message(paste0("Error occurred in DDFS for iteration = ", i, ": ", e))
            return(NULL)
          }
        )
        # # For plotting
        # mod <- ddfs(X, n = 4, min.intknots = min.intknots, phi_F = 0.2, q_F = 2, beta = 0,
        #             plot = TRUE, pdf = sim$f_X_func, cdf = sim$F_X_func )

        if(!is.null(GmodDens)){

          # PDF
          f_hat_DDFS <- GmodDens$f_X_hat$pred
          result$f_hat_DDFS <- f_hat_DDFS
          result$MSE_DDFS_pdf <- mean((f_X - f_hat_DDFS)^2)
          result$MAE_DDFS_pdf <- mean(abs(f_X - f_hat_DDFS))
          result$n_intknots_DDFS <- length(GmodDens$f_X_hat$knots) - GmodDens$f_X_hat$order*2
          f_pred_DDFS <- as.numeric(predict.ddfs(GmodDens, newdata = X_new, type = "density"))
          result$f_pred_DDFS <- f_pred_DDFS
          result$MISE_DDFS_pdf <- mean((f_X_new - f_pred_DDFS)^2)
          result$MIAE_DDFS_pdf <- mean(abs(f_X_new - f_pred_DDFS))
          result$roughness_DDFS_pdf <- roughness_numeric(X_new, result$f_pred_DDFS)

          # CDF
          F_hat_DDFS <- GmodDens$F_X_hat$pred
          result$F_hat_DDFS <- F_hat_DDFS
          result$MSE_DDFS_cdf <- mean((F_X - F_hat_DDFS)^2)
          result$MAE_DDFS_cdf <- mean(abs(F_X - F_hat_DDFS))
          result$F_pred_DDFS <- as.numeric(predict.ddfs(GmodDens, newdata = X_new, type = "distribution"))
          result$roughness_DDFS_cdf <- roughness_numeric(X_new, result$F_pred_DDFS)

        }
        end_time <- Sys.time()
        result$time_DDFS <- difftime(end_time, start_time, units = "secs")
      }

      # (II) kernel
      if ("kernel" %in% models_to_run) {
        start_time <- Sys.time()
        kernel_fit <- tryCatch(
          density(X, bw = "SJ", kernel = "optcosine"),
          error = function(e) {
            message(paste0("Error occurred in kernel for iteration = ", i, ": ", e))
            return(NULL)
          }
        )
        if(!is.null(kernel_fit)){

          # PDF
          f_hat_kernel <- approx(x = kernel_fit$x, y = kernel_fit$y, xout = X)$y
          result$f_hat_kernel <- f_hat_kernel
          result$MSE_kernel_pdf <- mean((f_X - f_hat_kernel)^2)
          result$MAE_kernel_pdf <- mean(abs(f_X - f_hat_kernel))
          f_pred_kernel <- as.numeric(approx(x = kernel_fit$x, y = kernel_fit$y, xout = X_new)$y)
          result$f_pred_kernel <- f_pred_kernel
          result$MISE_kernel_pdf <- mean((f_X_new - f_pred_kernel)^2)
          result$MIAE_kernel_pdf <- mean(abs(f_X_new - f_pred_kernel))
          result$roughness_kernel_pdf <- roughness_numeric(X_new, result$f_pred_kernel)

          # CDF
          kernelCDF <- CDF(kernel_fit)
          F_hat_kernel <- kernelCDF(X)
          result$F_hat_kernel <- F_hat_kernel
          result$MSE_kernel_cdf <- mean((F_X - F_hat_kernel)^2)
          result$MAE_kernel_cdf <- mean(abs(F_X - F_hat_kernel))
          result$F_pred_kernel <- kernelCDF(X_new)
          result$roughness_kernel_cdf <- roughness_numeric(X_new, result$F_pred_kernel)

        }
        end_time <- Sys.time()
        result$time_kernel <- difftime(end_time, start_time, units = "secs")
      }

      # (III) logspline
      if ("logspline" %in% models_to_run) {
        start_time <- Sys.time()
        logspline_fit <- tryCatch(
          logspline(X),
          error = function(e) {
            message(paste0("Error occurred in logspline for iteration = ", i, ": ", e))
            return(NULL)
          }
        )
        if(!is.null(logspline_fit)){

          # PDF
          f_hat_logspline <- dlogspline(X, logspline_fit)
          result$f_hat_logspline <- f_hat_logspline
          result$MSE_logspline_pdf <- mean((f_X - f_hat_logspline)^2)
          result$MAE_logspline_pdf <- mean(abs(f_X - f_hat_logspline))
          f_pred_logspline <- as.numeric(dlogspline(X_new, logspline_fit))
          result$f_pred_logspline <- f_pred_logspline
          result$MISE_logspline_pdf <- mean((f_X_new - f_pred_logspline)^2)
          result$MIAE_logspline_pdf <- mean(abs(f_X_new - f_pred_logspline))
          result$roughness_logspline_pdf <- roughness_numeric(X_new, result$f_pred_logspline)

          # CDF
          F_hat_logspline <- plogspline(X, logspline_fit)
          result$F_hat_logspline <- F_hat_logspline
          result$MSE_logspline_cdf <- mean((F_X - F_hat_logspline)^2)
          result$MAE_logspline_cdf <- mean(abs(F_X - F_hat_logspline))
          result$F_pred_logspline <- plogspline(X_new, logspline_fit)
          result$roughness_logspline_cdf <- roughness_numeric(X_new, result$F_pred_logspline)


        }
        end_time <- Sys.time()
        result$time_logspline <- difftime(end_time, start_time, units = "secs")
      }

      # (IV) lpdensity
      if ("lpdensity" %in% models_to_run) {
        start_time <- Sys.time()
        lpdensity_fit <- tryCatch(
          lpdensity(data = X, grid = X,  bwselect = "imse-dpi"),
          error = function(e) {
            message(paste0("Error occurred in lpdensity for iteration = ", i, ": ", e))
            return(NULL)
          }
        )
        if(!is.null(lpdensity_fit)){

          # PDF
          f_hat_lpdensity <- as.numeric(lpdensity_fit$Estimate[, "f_p"])
          result$f_hat_lpdensity <- f_hat_lpdensity
          result$MSE_lpdensity_pdf <- mean((f_X - f_hat_lpdensity)^2)
          result$MAE_lpdensity_pdf <- mean(abs(f_X - f_hat_lpdensity))
          f_pred_lpdensity <- as.numeric(lpdensity(data = X, grid = X_new,  bwselect = "imse-dpi")$Estimate[,"f_p"])
          result$f_pred_lpdensity <- f_pred_lpdensity
          result$MISE_lpdensity_pdf <- mean((f_X_new - f_pred_lpdensity)^2)
          result$MIAE_lpdensity_pdf <- mean(abs(f_X_new - f_pred_lpdensity))
          result$roughness_pdf <- roughness_numeric(X_new, result$f_pred_lpdensity)

          # CDF
          F_hat_lpdensity <- as.numeric(lpdensity(data = X, grid = X, v = 0, bwselect = "imse-dpi")$Estimate[,"f_p"])
          result$F_hat_lpdensity <- F_hat_lpdensity
          result$MSE_lpdensity_cdf <- mean((F_X - F_hat_lpdensity)^2)
          result$MAE_lpdensity_cdf <- mean(abs(F_X - F_hat_lpdensity))
          result$F_pred_lpdensity <- as.numeric(lpdensity(data = X, grid = X_new, v = 0, bwselect = "imse-dpi")$Estimate[,"f_p"])
          esult$roughness_cdf <- roughness_numeric(X_new, result$F_pred_lpdensity)


        }
        end_time <- Sys.time()
        result$time_lpdensity <- difftime(end_time, start_time, units = "secs")
      }

      return(result)
    }

    runs <- 100
    # Set a seed for reproducibility
    set.seed(123)
    # Get the number of cores
    # n_cores <- as.numeric(Sys.getenv("SLURM_CPUS_PER_TASK"))
    # Run the cross-validations in parallel
    # results <- mclapply(1:runs, function(i) run_models(i), mc.cores = n_cores)
    results <- lapply(1:runs, function(i) run_models(i, models_to_run))


    ###############################
    ####### Extract Results #######
    ###############################
    # (I) DDFS
    MSE_DDFS_pdf <- sapply(results, function(res)
      if(!is.null(res) && !is.null(res$MSE_DDFS_pdf)) res$MSE_DDFS_pdf else NA
    )
    MAE_DDFS_pdf <- sapply(results, function(res)
      if(!is.null(res) && !is.null(res$MAE_DDFS_pdf)) res$MAE_DDFS_pdf else NA
    )
    MISE_DDFS_pdf <- sapply(results, function(res)
      if(!is.null(res) && !is.null(res$MISE_DDFS_pdf)) res$MISE_DDFS_pdf else NA
    )
    MIAE_DDFS_pdf <- sapply(results, function(res)
      if(!is.null(res) && !is.null(res$MIAE_DDFS_pdf)) res$MIAE_DDFS_pdf else NA
    )
    roughness_DDFS_pdf <- sapply(results, function(res)
      if(!is.null(res) && !is.null(res$roughness_DDFS_pdf)) res$roughness_DDFS_pdf else NA
    )
    MSE_DDFS_cdf <- sapply(results, function(res)
