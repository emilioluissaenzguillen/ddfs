    # Save excel
    update_excel(results, models_to_run, output = paste0(output, "/xlsx/", ex,".xlsx"))

    # Save table
    df <- create_median_df(output = paste0(output, "/xlsx/", ex,".xlsx"))
    print(ex)
    print(df)
