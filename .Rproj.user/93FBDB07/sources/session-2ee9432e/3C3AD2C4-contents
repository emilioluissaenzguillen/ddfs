      if(!is.null(res) && !is.null(res$MIAE_logspline_pdf)) res$MIAE_logspline_pdf else NA
    )
    roughness_logspline_pdf <- sapply(results, function(res)
      if(!is.null(res) && !is.null(res$roughness_logspline_pdf)) res$roughness_logspline_pdf else NA
    )
    MSE_logspline_cdf <- sapply(results, function(res)
      if(!is.null(res) && !is.null(res$MSE_logspline_cdf)) res$MSE_logspline_cdf else NA
    )
    MAE_logspline_cdf <- sapply(results, function(res)
