    )
    roughness_logspline_cdf <- sapply(results, function(res)
      if(!is.null(res) && !is.null(res$roughness_logspline_cdf)) res$roughness_logspline_cdf else NA
    )
    n_intknots_logspline <- sapply(results, function(res)
      if(!is.null(res) && !is.null(res$n_intknots_logspline)) res$n_intknots_logspline else NA
