#######################################################################
# If `i_star == 1`, set `cdf_prev` to the same row as `cdf_current` since  F_0(x|z_0) = F_1(x|z_1)
cdf_prev_indices <- lapply(i_star, function(i) ifelse(i == 1, i, i - 1))
cdf_current_indices <- i_star
# Calculate the weight w
w <- Map(function(z, i) z - (i - 1), Z_new, i_star)

# Compute \tilde{x}|z for each \hat{\tilde{F}}_{i^*-1,n}(x|z_{i^*-1})
# and \hat{\tilde{F}}_{i^*,n}(x|z_{i^*})
generate_X_tilde <- function(v, cdf_indices, ddfs_X_tilde_cond) {
  # Generate a random value u
  set.seed(123)
  u <- runif(v)

  # Compute X_tilde
  sapply(seq_len(v), function(i) {
    # Select \hat{\tilde{F}}_{i^*-1,n}(x|z_{i^*-1}) or \hat{\tilde{F}}_{i^*,n}(x|z_{i^*})
    perc_inc_cond <- ddfs_X_tilde_cond[[cdf_indices[i]]]

    # Piecewise polynomial representation + Invert cubic polynomial
    q.ddfs(perc_inc_cond, u[i])
  })
}

X_tilde_prev <- mapply(
  function(v, idx, cond) generate_X_tilde(v, idx, cond),
  v = v,
  idx = cdf_prev_indices,
  cond = ddfs_X_tilde_cond,
  SIMPLIFY = FALSE
)

X_tilde_current <- mapply(
  function(v, idx, cond) generate_X_tilde(v, idx, cond),
  v = v,
  idx = cdf_current_indices,
  cond = ddfs_X_tilde_cond,
  SIMPLIFY = FALSE
)

# Simulate binomial variable
z <- Map(function(n, p) {
  set.seed(123)
  rbinom(length(p), size = 1, prob = p)
}, n = v, p = w)

# Compute \tilde{x}|z from the mixed cdf \tilde{F}(x|z)
X_tilde <- Map(function(zg, x_prev, x_curr) {
  (1 - zg) * x_prev + zg * x_curr
}, z, X_tilde_prev, X_tilde_current)

