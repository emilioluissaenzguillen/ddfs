set.seed(123)

N <- 100
runs <- 100

examples <- c("Gaussian", "Student-t", "Exponential", "Chi-square", "Gamma", "Weibull",
              "Log-normal", "Nakagami", "Kurtotic unimodal", "Outlier", "Skewed unimodal",
              "Strongly skewed", "Merton's jump diffusion",
              "GEV Type I", "GEV Type II", "GEV Type III")

rule_names <- c("nrd0", "nrd", "ucv", "bcv", "SJ")

for (ex in examples) {
  # Reinitialize difference matrix per example
  diffs <- matrix(NA, nrow = runs, ncol = 5)
  colnames(diffs) <- rule_names

  for (i in 1:runs) {
    sim <- sim.dist(N = N, ex = ex)
    X <- sim$X




    X_trim <- sort(X)
    n      <- length(X_trim)
    k      <- floor(n * 0.01)
    if (k > 0) X_trim <- X_trim[(k + 1):(n - k)]
    c <- (2*kurtosis(X_trim))

    c <- kurtosis(X)

    min.intknots <- get_params(N, ex = ex)$min.intknots

    rules <- c(
      round(diff(range(X)) / (bw.nrd0(X) * c)),
      round(diff(range(X)) / (bw.nrd(X) * c)),
      round(diff(range(X)) / (bw.ucv(X) * c)),
      round(diff(range(X)) / (bw.bcv(X) * c)),
      round(diff(range(X)) / (bw.SJ(X) * c))
    )

    diffs[i, ] <- abs(rules - min.intknots)
  }

  mean_diffs <- colMeans(diffs)
  best_rule_index <- which.min(mean_diffs)
  best_rule_name <- rule_names[best_rule_index]
  best_rule_value <- mean_diffs[best_rule_index]

  cat(sprintf("Best rule for %-25s: %-5s (Mean abs. diff = %.3f)\n",
              ex, best_rule_name, best_rule_value))
}












