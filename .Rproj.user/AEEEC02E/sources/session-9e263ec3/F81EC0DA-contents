## see also examples in ?gam.models (e.g. 'by' variables,
## random effects and tricks for large binary datasets)
library(mgcv)
set.seed(123) ## simulate some data...

f_x0x1x2 <- function(x0,x1,x2) {
  f0 <- function(x0) 2 * sin(pi * x0)
  f1 <- function(x1) exp(2 * x1)
  f2 <- function(x2) 0.2 * x2^11 * (10 * (1 - x2))^6 + 10 * (10 * x2)^3 * (1 - x2)^10

  f <- f0(x0) + f1(x1) + f2(x2)

  return(f)
}

data <- gamSim(1,n=400,dist="normal",scale=0.2)
f <- f_x0x1x2(x0 = data$x0, x1 = data$x1, x2 = data$x2)

# check
set.seed(123)
data_no_noise <- gamSim(1,n=400,dist="normal",scale=0)
data_no_noise$y - f

