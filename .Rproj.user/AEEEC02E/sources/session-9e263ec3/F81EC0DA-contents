N <- 1000
# 0.3N(1, 0.5^2) + 0.2N(4.5, 1.2^2) + 0.5N(8, 0.8^2) in [0,10]
mu1 <- 1; sigma1 <- 0.5; p1 <- 0.3
mu2 <- 4.5; sigma2 <- 1.2; p2 <- 0.2
mu3 <- 8; sigma3 <- 0.8; p3 <- 1 - p1 - p2
a <- -Inf; b <- +Inf

# Precompute probabilities for truncation
p_lower1 <- pnorm(a, mean = mu1, sd = sigma1)
p_upper1 <- pnorm(b, mean = mu1, sd = sigma1)
p_lower2 <- pnorm(a, mean = mu2, sd = sigma2)
p_upper2 <- pnorm(b, mean = mu2, sd = sigma2)
p_lower3 <- pnorm(a, mean = mu3, sd = sigma3)
p_upper3 <- pnorm(b, mean = mu3, sd = sigma3)

for (i in 1:42) {
  # Generate random samples for each component
  U1 <- runif(N, min = p_lower1, max = p_upper1)
  U2 <- runif(N, min = p_lower2, max = p_upper2)
  U3 <- runif(N, min = p_lower3, max = p_upper3)

  X1 <- qnorm(U1, mean = mu1, sd = sigma1)
  X2 <- qnorm(U2, mean = mu2, sd = sigma2)
  X3 <- qnorm(U3, mean = mu3, sd = sigma3)

  # Sampling from the mixture
  U <- runif(N)  # Random uniforms to assign components
  X <- numeric(N)  # Placeholder for the final samples

  for (i in 1:N) {
    if (U[i] < p1) {
      X[i] <- sample(X1, 1)  # Sample one value from X1
    } else if (U[i] < p1 + p2) {
      X[i] <- sample(X2, 1)  # Sample one value from X2
    } else {
      X[i] <- sample(X3, 1)  # Sample one value from X3
    }
  }
}

X <- sort(X)

GmodDens <- ddfs(X, n = 4, min_iterations = 6 + 2, phi_F = 0.9, q_F = 2, beta = 0)

