## 2. p(t)
# Define the function p(t) = ae^{−bt} (exponential price decline model)
p <- function(a, b, t) {
  a * exp(-b * t)
}

# Compute p(t) for each t
compute_p_vals <- function(t_values) {
  a <- min(
    range(ddfs$ddfs_X$F_X_hat$knots)[2],
    range(ddfs$ddfs_XZ$F_XY_hat$knots$Xk)[2],
    range(ddfs$ddfs_X_tilde$F_X_hat$knots)[2],
    range(ddfs$ddfs_X_tildeZ$F_XY_hat$knots$Xk)[2]
  )
  b <- -log(
    max(
      range(ddfs$ddfs_X$F_X_hat$knots)[1],
      range(ddfs$ddfs_XZ$F_XY_hat$knots$Xk)[1],
      range(ddfs$ddfs_X_tilde$F_X_hat$knots)[1],
      range(ddfs$ddfs_X_tildeZ$F_XY_hat$knots$Xk)[1]
    ) / a
  ) / max(t_values)
  p_vals <- p(a, b, t_values)

  list(
    a = a,
    b = b,
    p_vals = p_vals
  )
}

