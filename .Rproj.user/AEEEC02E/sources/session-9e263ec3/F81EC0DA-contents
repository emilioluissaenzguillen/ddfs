    F_X_p_t        = F_pt$base,
    F_X_p_t_poorer = F_pt$poorer,
    F_X_p_t_richer = F_pt$richer,
    F_T_c          = 1 - F_pt$base,
    F_T_c_poorer   = 1 - F_pt$poorer,
