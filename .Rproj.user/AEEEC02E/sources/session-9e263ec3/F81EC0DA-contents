# Helper: compute (c, d) for one group
compute_params <- function(Z, XZ, erosion, t_max, eps = 1e-12) {
  rZuniv <- range(Z$F_X_hat$knots)
  rZbiv <- range(XZ$F_XY_hat$knots$Yk)

  minZuniv <- rZuniv[1]; spanZuniv <- rZuniv[2] - rZuniv[1]
  minZbiv  <- rZbiv[1];  spanZbiv  <- rZbiv[2] - rZbiv[1]

  base  <- max(minZuniv, minZbiv)
  c_val <- base + erosion * min(spanZuniv, spanZbiv)

  # clamp ratio to (0,1) to avoid log(<=0) or log(>1) from round-off
  ratio <- pmin(pmax(base / c_val, eps), 1 - eps)
  d_val <- -log(ratio) / t_max

  list(c = c_val, d = d_val)
}

