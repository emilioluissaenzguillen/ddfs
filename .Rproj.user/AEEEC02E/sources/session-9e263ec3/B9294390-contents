ddfs_X_tilde_cond <- list()
for (i in 1:m) {
  # Step 1: \tilde{F}_{i,n}(x|z_{i})
  perc_inc_cond_ecdf <- data.frame(X = range_labels, F_X = as.numeric(mean_data$base[i,]))
  # Step 2: Generate n random uniform values
  set.seed(123)
  u <- runif(nrow(data_study$base))
  # Step 3: Find intervals in `perc_inc_ecdf based on `u` and calculate income values
  inc_interval <- inverse_F_X(u, df = perc_inc_cond_ecdf)
  # Step 4: Generate income values based on the intervals and return
  X_tilde <- sapply(inc_interval, function(label) generate_random_income(label, unif = FALSE))
  # Step 5: Fit DDFS
  ddfs_X <- ddfs(data = sort(X_tilde), n = 4, phi_F = 0.8, q_F = 2)
  plot(ddfs_X, type = "distribution")
  
  ddfs_X_tilde_cond[[i]] <- ddfs_X
}