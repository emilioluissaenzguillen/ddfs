income_brackets <- c("£0-15k", "£15k-30k", "£30k-45k", "£45k-60k",
"£60k-75k", "£75k-90k", "£90k-105k", "£105k-120k", "£120k or Above")
data_surveypart2 <- data_surveypart2[rowSums(data_surveypart2[income_brackets]) == 100, ]
data_surveypart2 <- data_surveypart2[!duplicated(data_surveypart2$id), ]
######################################################
## 2) Import Survey Part I results for segmentation ##
######################################################
data_surveypart1 <- read_excel("input/part_I/EPS+Survey+Part+I_July+20,+2024_11.26.xlsx",
sheet = "Data",
range = "T1:AY1005")
data_surveypart1 <- data_surveypart1[-1, ]
income_brackets <- c("£0-15,000", "£15,001-30,000", "£30,001-45,000", "£45,001-60,000", "£60,001-75,000",
"£75,001-90,000", "£90,001-105,000", "£105,001-120,000", "£120,001 or Above")
# Remove rows where Q2.Income is NA
data_surveypart1 <- data_surveypart1[!is.na(data_surveypart1$Q2.Income), ]
# Factorize income variable
data_surveypart1$Q2.Income <- factor(data_surveypart1$Q2.Income,
levels = income_brackets,
ordered = TRUE)
##########
# Poorer #
##########
quartile_income25 <- levels(data_surveypart1$Q2.Income)[
quantile(as.numeric(data_surveypart1$Q2.Income), 0.25, type = 1)
]
poorer <- data_surveypart1 %>%
dplyr::filter(Q2.Income <= quartile_income25) %>%
dplyr::select(id = Q0.ID, poorer = Q2.Income)
##########
# Richer #
##########
quartile_income75 <- levels(data_surveypart1$Q2.Income)[
quantile(as.numeric(data_surveypart1$Q2.Income), 0.75, type = 1)
]
richer <- data_surveypart1 %>%
dplyr::filter(Q2.Income > quartile_income75) %>%
dplyr::select(id = Q0.ID, richer = Q2.Income)
# Put both into a list
data_study <- list(
base = data_surveypart2,
poorer = inner_join(data_surveypart2, poorer, by = "id"),
richer = inner_join(data_surveypart2, richer, by = "id")
)
#######################
##  Sample (X_i,Z_i) ##
#######################
# Income breakpoints
breaks_inc <- c(5000, 15000, 30000, 45000, 60000, 75000,
90000, 105000, 120000, 135000)
# Helper to build (X,Z) dataset for one subset
build_sample <- function(df, income_brackets) {
indices <- which(income_brackets %in% unique(df$income))
breaks_sel <- breaks_inc[unique(c(indices, indices + 1))]
inc_brackets_sel <- income_brackets[indices]
# Midpoints of ranges
midpoints_inc <- (breaks_sel[-length(breaks_sel)] + breaks_sel[-1]) / 2
names(midpoints_inc) <- inc_brackets_sel
X <- midpoints_inc[df$income]
data.frame(X = X, Z = df$Z)
}
# Create another list with the (X,Z) samples
data <- lapply(data_study, build_sample, income_brackets = income_brackets)
################################################################################
###################### Step 1: Recover Income (X) sample  ######################
################################################################################
################################################################################
################ 3rd approach (X, Z|X) sample (recovered sample) ###############
################################################################################
#############################################################################
## (a) Use the DDFS fit \hat{F}_X(x), to generate a real income variate, x ##
#############################################################################
## 1. Get the DDFS fit of the ecdf of X
ddfs_X <- lapply(data, function(df) {
d <- ddfs(sort(df$X), n = 4, phi_F = 0.8, q_F = 2)
plot(d, type = "distribution")
return(d)
})
