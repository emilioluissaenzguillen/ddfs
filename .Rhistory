## ============================================================
## 1. Monte Carlo stability of aggregate-loss risk measures
## ============================================================
## This is a numerical sensitivity check with fitted models held fixed.
## It does not measure parameter uncertainty or out-of-sample accuracy.
project_dir <- paste0(
"C:/Users/emili/Dropbox/Bayes Business School/PhD/Research/",
"Projects/Future Research/Tzougas"
)
setwd(project_dir)
library(data.table)
library(copula)
source("functions.R")
ddfs_path <- paste0(
"C:/Users/emili/Dropbox/Bayes Business School/PhD/Research/",
"Projects/PDF and CDF Estimation/R package/ddfs"
)
devtools::load_all(ddfs_path, quiet = TRUE)
risk_objects <- readRDS("data/raw_loss_risk_objects.rds")
## Build a fast numerical inverse once per margin to avoid millions of
## polynomial root solves. Check it against the corrected q.ddfs first.
make_sensitivity_quantile <- function(fit) {
support <- range(fit$args$X)
x <- seq(support[1], support[2], length.out = 100001L)
p <- drop(p.ddfs(fit, x))
stopifnot(all(is.finite(p)), all(diff(p) >= -1e-10))
p <- cummax(pmin(pmax(p, 0), 1))
keep <- !duplicated(p)
inverse <- approxfun(p[keep], x[keep], rule = 2)
function(probability) exp(inverse(probability))
}
q_BI <- make_sensitivity_quantile(risk_objects$fit_S1)
q_PD <- make_sensitivity_quantile(risk_objects$fit_S2)
check_probabilities <- sort(unique(c(
seq(0.001, 0.999, length.out = 1000L),
0.9999, 0.99999, 0.999999
)))
check_inverse <- function(fit, inverse, margin) {
reference <- exp(drop(q.ddfs(fit, check_probabilities)))
approximation <- inverse(check_probabilities)
data.table(
Margin = margin,
Maximum_relative_error = max(abs(
approximation / reference - 1
))
)
}
MC_inverse_check <- rbind(
check_inverse(risk_objects$fit_S1, q_BI, "BI"),
check_inverse(risk_objects$fit_S2, q_PD, "PD")
)
print(MC_inverse_check)
if (any(MC_inverse_check$Maximum_relative_error > 1e-4)) {
stop("Quantile approximation needs inspection before simulation.")
}
mixed_loss <- function(u, zero_mass, inverse) {
loss <- numeric(length(u))
positive <- u > zero_mass
loss[positive] <- inverse(
(u[positive] - zero_mass) / (1 - zero_mass)
)
loss
}
## Thirty independent runs provide an initial estimate of Monte Carlo
## variability. Each run has 500 expected draws beyond the 99.5% VaR.
MC_replications <- 30L
MC_sample_size <- 100000L
MC_levels <- c(0.95, 0.99, 0.995)
run_MC_replication <- function(replication, model) {
## Distinct seeds across models and replications.
set.seed(60000L + 2L * replication + as.integer(model == "Frank"))
if (model == "Frank") {
u <- rCopula(
MC_sample_size,
frankCopula(risk_objects$Frank_parameter, dim = 2)
)
} else {
u <- simulate_from_gridded_copula(
risk_objects$local_density,
risk_objects$local_grid,
MC_sample_size
)
}
loss <- mixed_loss(u[, 1], risk_objects$zero_mass_S1, q_BI) +
mixed_loss(u[, 2], risk_objects$zero_mass_S2, q_PD)
rbindlist(lapply(MC_levels, function(level) {
value_at_risk <- unname(quantile(loss, level, type = 7))
## Empirical integrated-quantile TVaR, including fractional weight
## at the threshold if necessary.
tail_value_at_risk <- value_at_risk +
mean(pmax(loss - value_at_risk, 0)) / (1 - level)
data.table(
Replication = replication,
Model = model,
Level = level,
VaR = value_at_risk,
TVaR = tail_value_at_risk
)
}))
}
MC_results <- rbindlist(lapply(seq_len(MC_replications), function(i) {
message("Monte Carlo stability run ", i, " of ", MC_replications)
rbind(
run_MC_replication(i, "Frank"),
run_MC_replication(i, "Calibrated local Gaussian")
)
}))
MC_long <- melt(
MC_results,
id.vars = c("Replication", "Model", "Level"),
measure.vars = c("VaR", "TVaR"),
variable.name = "Measure",
value.name = "Estimate"
)
MC_stability_summary <- MC_long[, .(
Replications = .N,
Draws_per_run = MC_sample_size,
Mean_estimate = mean(Estimate),
MC_SD = sd(Estimate),
MC_SD_percent = 100 * sd(Estimate) / mean(Estimate)
), by = .(Model, Level, Measure)]
setorder(MC_stability_summary, Level, Measure, Model)
MC_model_differences <- dcast(
MC_long,
Replication + Level + Measure ~ Model,
value.var = "Estimate"
)
MC_model_differences[, Difference :=
`Calibrated local Gaussian` - Frank
]
MC_difference_summary <- MC_model_differences[, .(
Mean_local_minus_Frank = mean(Difference),
MC_SD_difference = sd(Difference),
Difference_to_MC_SD = mean(Difference) / sd(Difference)
), by = .(Level, Measure)]
setorder(MC_difference_summary, Level, Measure)
print(MC_stability_summary)
print(MC_difference_summary)
## Preserve the complete numerical experiment without modifying the
## fitted objects or the main analysis results.
saveRDS(
list(
inverse_check = MC_inverse_check,
results = MC_results,
stability = MC_stability_summary,
differences = MC_difference_summary,
sample_size = MC_sample_size,
replications = MC_replications
),
"data/risk_MC_sensitivity.rds"
)
## ============================================================
## 2. Grid refinement with the fitted surface and delta held fixed
## ============================================================
## Refresh the cache by running only Section 16 of S1S2_raw.R first.
## This check isolates numerical resolution: no statistical refitting,
## change in endpoint probabilities, or marginal-tail alteration occurs.
risk_objects <- readRDS("data/raw_loss_risk_objects.rds")
required_grid_fields <- c(
"local_coarse_grid", "local_rho_surface", "local_delta"
)
if (!all(required_grid_fields %in% names(risk_objects))) {
stop("Run the updated saveRDS block in Section 16 of S1S2_raw.R first.")
}
## Rebuild inverses from the same cache to avoid stale session objects.
q_BI <- make_sensitivity_quantile(risk_objects$fit_S1)
q_PD <- make_sensitivity_quantile(risk_objects$fit_S2)
grid_sizes <- c(length(risk_objects$local_grid), 81L, 161L)
stopifnot(grid_sizes[1] == 41L)
grid_fits <- lapply(grid_sizes, function(size) {
grid <- pnorm(seq(
qnorm(min(risk_objects$local_grid)),
qnorm(max(risk_objects$local_grid)),
length.out = size
))
points <- expand.grid(u = grid, v = grid)
rho <- bilinear_surface(
points$u, points$v,
risk_objects$local_coarse_grid,
risk_objects$local_rho_surface
)
shifted_rho <- tanh(atanh(rho) + risk_objects$local_delta)
raw_density <- matrix(
varying_gaussian_copula_density(
shifted_rho, qnorm(points$u), qnorm(points$v)
),
nrow = size
)
weights <- copula_grid_weights(grid)
calibrated <- calibrate_copula_margins(raw_density, weights)
list(
grid = grid,
density = calibrated$density,
max_margin_error = max(abs(c(
drop(calibrated$density %*% weights) - 1,
drop(t(calibrated$density) %*% weights) - 1
)))
)
})
## Verify that reconstruction on the original grid reproduces the model
## used in the paper before comparing it with finer-grid versions.
grid_baseline_error <- max(abs(
grid_fits[[1]]$density - risk_objects$local_density
))
print(c(Maximum_baseline_density_difference = grid_baseline_error))
stopifnot(grid_baseline_error < 1e-8)
grid_replications <- 20L
grid_sample_size <- 200000L
grid_risk_results <- rbindlist(lapply(seq_along(grid_fits), function(j) {
fitted <- grid_fits[[j]]
message("Grid sensitivity: ", grid_sizes[j], " x ", grid_sizes[j])
rbindlist(lapply(seq_len(grid_replications), function(i) {
## Reuse seeds across resolutions; paired run differences account
## for any resulting Monte Carlo covariance.
set.seed(80000L + i)
u <- simulate_from_gridded_copula(
fitted$density, fitted$grid, grid_sample_size
)
loss <- mixed_loss(u[, 1], risk_objects$zero_mass_S1, q_BI) +
mixed_loss(u[, 2], risk_objects$zero_mass_S2, q_PD)
rbindlist(lapply(MC_levels, function(level) {
v <- unname(quantile(loss, level, type = 7))
data.table(
Grid_size = grid_sizes[j], Replication = i, Level = level,
VaR = v, TVaR = v + mean(pmax(loss - v, 0)) / (1 - level)
)
}))
}))
}))
grid_risk_long <- melt(
grid_risk_results,
id.vars = c("Grid_size", "Replication", "Level"),
measure.vars = c("VaR", "TVaR"),
variable.name = "Measure", value.name = "Estimate"
)
grid_risk_summary <- grid_risk_long[, .(
Mean_estimate = mean(Estimate),
MC_SE_mean = sd(Estimate) / sqrt(.N)
), by = .(Grid_size, Level, Measure)]
baseline_grid_scores <- grid_risk_long[Grid_size == 41L, .(
Replication, Level, Measure, Baseline_estimate = Estimate
)]
grid_risk_paired <- merge(
grid_risk_long, baseline_grid_scores,
by = c("Replication", "Level", "Measure")
)
grid_risk_paired[, Change := Estimate - Baseline_estimate]
grid_change_summary <- grid_risk_paired[, .(
Mean_change_vs_41 = mean(Change),
Percent_change_vs_41 = 100 * mean(Change) / mean(Baseline_estimate),
MC_SE_change = sd(Change) / sqrt(.N)
), by = .(Grid_size, Level, Measure)]
grid_risk_summary <- merge(
grid_risk_summary, grid_change_summary,
by = c("Grid_size", "Level", "Measure")
)
setorder(grid_risk_summary, Level, Measure, Grid_size)
print(grid_risk_summary)
saveRDS(list(
results = grid_risk_results,
summary = grid_risk_summary,
baseline_error = grid_baseline_error,
margin_errors = sapply(grid_fits, function(x) x$max_margin_error),
fixed_delta = risk_objects$local_delta,
replications = grid_replications,
sample_size = grid_sample_size
), "data/risk_grid_sensitivity.rds")
print(grid_risk_summary)
