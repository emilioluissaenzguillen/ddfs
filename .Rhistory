Parametric_log_score = Test_log_score
)
]
raw_loss_local_vs_best_yearly <- merge(
raw_loss_local_yearly,
raw_loss_best_parametric_yearly,
by = "Test_year"
)
raw_loss_local_vs_best_yearly[, `:=`(
Score_difference =
Local_log_score - Parametric_log_score,
Average_difference =
(Local_log_score - Parametric_log_score) /
Test_cells
)]
print(raw_loss_local_vs_best_yearly)
## ============================================================
## 14. Uncertainty in the predictive comparison
## ============================================================
## Resample complete years to preserve dependence among the validation
## scores belonging to the same calendar year.
set.seed(1501)
raw_loss_bootstrap_replications <- 9999L
n_raw_loss_validation_years <- nrow(
raw_loss_local_vs_best_yearly
)
raw_loss_bootstrap_differences <- replicate(
raw_loss_bootstrap_replications,
{
sampled_years <- sample.int(
n_raw_loss_validation_years,
size = n_raw_loss_validation_years,
replace = TRUE
)
sum(
raw_loss_local_vs_best_yearly$Score_difference[
sampled_years
]
) / sum(
raw_loss_local_vs_best_yearly$Test_cells[
sampled_years
]
)
}
)
raw_loss_sign_test <- binom.test(
x = sum(
raw_loss_local_vs_best_yearly$Score_difference > 0
),
n = n_raw_loss_validation_years,
p = 0.5,
alternative = "two.sided"
)
raw_loss_LOYO_uncertainty <- data.table(
Parametric_benchmark = strongest_raw_loss_parametric,
Average_score_difference =
sum(raw_loss_local_vs_best_yearly$Score_difference) /
sum(raw_loss_local_vs_best_yearly$Test_cells),
CI_lower = unname(quantile(
raw_loss_bootstrap_differences,
probs = 0.025
)),
CI_upper = unname(quantile(
raw_loss_bootstrap_differences,
probs = 0.975
)),
Bootstrap_probability_positive = mean(
raw_loss_bootstrap_differences > 0
),
Years_won = sum(
raw_loss_local_vs_best_yearly$Score_difference > 0
),
Years_compared = n_raw_loss_validation_years,
Exact_two_sided_p_value = raw_loss_sign_test$p.value,
Bootstrap_replications = raw_loss_bootstrap_replications
)
print(raw_loss_LOYO_uncertainty)
## ============================================================
