remotes::install_github("emilioluissaenzguillen/GeDS")
remotes::install_github("emilioluissaenzguillen/ddfs")
remotes::install_github("emilioluissaenzguillen/ddfs", force = TRUE)
library(ddfs)
# Simulate data and fit a CDF
set.seed(123)
sim <- sim.dist(N = 1000, ex = "Gaussian")
ddfs_fit <- ddfs(sim$X)
# Plot estimated pdf/cdf
plot(ddfs_fit, type = "density", f = sim$f_X_func)
plot(ddfs_fit, type = "distribution", f = sim$F_X_func)
plot(ddfs_fit, type = "pdf", f = sim$f_X_func)
plot(ddfs_fit, type = "cdf", f = sim$F_X_func)
plot(ddfs_fit, model = "cdf", f = sim$F_X_func)
plot(ddfs_fit, model = "pdf", f = sim$f_X_func)
ddfs:::plot.ddfs
plot(ddfs_fit, fit = "pdf", f = sim$f_X_func)
plot(ddfs_fit, fit = "cdf", f = sim$F_X_func)
