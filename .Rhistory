title(ylab = expression(textstyle(frac(1, N)) * "||" * f - hat(f) * "||"[2]^2), line = 3, cex.lab = 2)
par(mai=c(1.02,0.82,0.82,0.42))
# Copy the plot to PDF
dev.copy(pdf, file = paste0(output, "/boxplot_", ex, ".pdf"), width = 8, height = 8)
dev.off()
}
}
################################################################################
################################# PDF BOXPLOTS #################################
################################################################################
# First, clear all
rm(list = ls())
graphics.off()
# Set directory
setwd("C:/Users/addj700/Dropbox/Bayes Business School/PhD/Research/PhD - Saenz, Emilio/Projects/PDF and CDF Estimation/examples/simulation_univariate/examples - Cui et al. (2020)")
# Load packages
pacman::p_load(readxl, dplyr, tidyr, openxlsx)
# Define Ns and examples
examples <- c("Gaussian", "Student-t", "Exponential", "Chi-square", "Gamma", "Weibull",
"Log-normal", "Nakagami", "Kurtotic unimodal", "Outlier", "Skewed unimodal",
"Strongly skewed", "Merton's jump diffusion", "Kou's double exponential",
"GEV Type I", "GEV Type II", "GEV Type III",
"MixGauss", "Mix1d", "MixGauss2", "MixGauss3",
"Bimodal", "Separated bimodal", "Skewed bimodal",
"Trimodal", "Smooth comb", "Claw")
Ns <- c("N=100", "N=1000", "N=10000")
# examples <- c("Strongly skewed")
# Ns <- "N=100"
for (ex in examples) {
for (N in Ns) {
input <- paste0(getwd(), "/hpc/csv/csv_mix/", N)
output <- paste0(getwd(), "/output/", N, "/figures")
sheet_map <- c("N=100000" = "N_100000", "N=10000" = "N_10000",
"N=1000" = "N_1000", "N=100" = "N_100")
# Import Zhenyu Cui et al.
data_ecf <- read.xlsx(paste0("output/data/", ex, "_ecf_MSE_MAE_Plugin.xlsx"), sheet = sheet_map[N],
colNames = FALSE, cols = 3:4)
names(data_ecf) <- c("ISE_ecf_pdf", "IAE_ecf_pdf")
# Import Kirkby et al.
data_galerkin <- read.xlsx(paste0("output/data/", ex, "_galerkin_MSE_MAE.xlsx"), sheet = sheet_map[N],
colNames = FALSE, cols = 3:4)
names(data_galerkin) <- c("ISE_galerkin_pdf", "IAE_galerkin_pdf")
# The rest
file_path <- paste0(input, "/", ex, ".csv")
data_ISE <- read.csv(file_path) %>%
dplyr::select(starts_with("ISE_"))  %>%
mutate(across(everything(), as.numeric))
data_ISE <- cbind(data_ISE, data_ecf, data_galerkin)
################
### Boxplots ###
################
ddfs_color <- "red"
kernel_color <- "blue"
botev_color <- "brown"
logspline_color <- "green"
ecf_color <- "pink"
galerkin_color <- "yellow"
boxplot_colors <- c(ddfs_color, kernel_color, botev_color, logspline_color, ecf_color, galerkin_color)
data_ISE1 <- data_ISE %>%
dplyr::select(ISE_DDFS_pdf, ISE_kernel_pdf, ISE_Botev_pdf, ISE_logspline_pdf, ISE_ecf_pdf, ISE_galerkin_pdf)
data_ISE1 <- na.omit(data_ISE1)
whiskers <- sapply(data_ISE1, function(col) {
stats <- boxplot.stats(col)
stats$stats[5]   # the top whisker (R convention)
})
max_whisker <- max(whiskers, na.rm = TRUE)
par(mai=c(0.82,1.42,0.82,0.42))
boxplot(data_ISE1, ylab="",
col=boxplot_colors,
names = c("DDFS", "kernel", "Botev", "logspline", "ECF", "Galerkin"),
cex.main = 3, cex.axis = 1,
ylim = c(min(boxplot(data_ISE1, plot = FALSE)$stats), max_whisker*1.05) )
title(ylab = expression(textstyle(frac(1, N)) * "||" * f - hat(f) * "||"[2]^2), line = 3, cex.lab = 2)
par(mai=c(1.02,0.82,0.82,0.42))
# Copy the plot to PDF
dev.copy(pdf, file = paste0(output, "/boxplot_", ex, ".pdf"), width = 8, height = 8)
dev.off()
}
}
