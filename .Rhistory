weighted.mean(
differences$Joint_difference,
differences$Test_cells
)
),
CI_lower = apply(
bootstrap_scores,
1,
quantile,
probs = 0.025
),
CI_upper = apply(
bootstrap_scores,
1,
quantile,
probs = 0.975
),
Bootstrap_probability_local_better = c(
mean(bootstrap_scores["Quantile", ] < 0),
mean(bootstrap_scores["Joint", ] < 0)
),
Years_local_better = c(
sum(differences$Quantile_difference < 0),
sum(differences$Joint_difference < 0)
),
Years_compared = number_years
)
}
raw_loss_risk_score_uncertainty_all_levels <- rbindlist(list(
bootstrap_risk_score_level(0.95, "95"),
bootstrap_risk_score_level(0.99, "99"),
bootstrap_risk_score_level(0.995, "995")
))
print(raw_loss_risk_score_uncertainty_all_levels)
## LaTeX table for the out-of-sample risk assessment. Confidence
## intervals for paired score differences are reported in the text.
raw_loss_risk_backtest_table <- copy(
raw_loss_risk_backtest_all_levels
)
raw_loss_risk_backtest_table[, `:=`(
Level = sprintf("%.1f\\%%", 100 * Level),
Exceedances = sprintf(
"%d (%.2f\\%%)",
Exceedances,
100 * Exceedance_rate
),
Average_quantile_score = formatC(
Average_quantile_score,
format = "f",
digits = 1,
big.mark = ","
),
Average_joint_VaR_TVaR_score = sprintf(
"%.4f",
Average_joint_VaR_TVaR_score
)
)]
raw_loss_risk_backtest_table[, c(
"Held_out_cells",
"Exceedance_rate"
) := NULL]
setnames(
raw_loss_risk_backtest_table,
c(
"Average_quantile_score",
"Average_joint_VaR_TVaR_score"
),
c(
"Average quantile score",
"Average joint score"
)
)
raw_loss_risk_backtest_table_latex <- kable(
raw_loss_risk_backtest_table,
format = "latex",
booktabs = TRUE,
align = c("l", "r", "r", "r", "r"),
escape = FALSE,
linesep = "",
caption = paste(
"Leave-one-year-out assessment of aggregate-loss risk forecasts",
"based on 900 held-out risk cells. Parentheses report empirical",
"VaR exceedance rates; lower average scores indicate better",
"predictive performance. Results at 99\\% and 99.5\\% are interpreted",
"cautiously because few exceedances are expected."
),
caption.position = "top",
label = "aggregate-loss-risk-backtest"
)
print(raw_loss_risk_backtest_table_latex)
## Identify the strongest standard copula from held-out performance.
strongest_raw_loss_parametric <- raw_loss_LOYO_summary[
Model != "Calibrated local Gaussian"
][which.max(Average_log_score), Model]
raw_loss_local_yearly <- raw_loss_LOYO_results[
Model == "Calibrated local Gaussian",
.(
Test_year,
Test_cells,
Local_log_score = Test_log_score
)
]
raw_loss_best_parametric_yearly <- raw_loss_LOYO_results[
