################################################################################
# Cui Z, Kirkby JL, Nguyen D.
# NONPARAMETRIC DENSITY ESTIMATION BY B-SPLINE DUALITY.
# Econometric Theory. 2020;36(2):250-291. doi:10.1017/S0266466619000112
# TABLE 2. Test case densities for numerical experiments
################################################################################
models_to_run =  c("DDFS", "kernel", "Botev", "logspline", "lpdensity")
Ns <- c(10^2, 10^3, 10^4)
examples <- c("Gaussian", "Student-t", "Exponential", "Chi-square", "Gamma", "Weibull",
"Log-normal", "Nakagami", "Kurtotic unimodal", "Outlier", "Skewed unimodal",
"Strongly skewed", "Merton's jump diffusion", "Kou's double exponential",
"GEV Type I", "GEV Type II", "GEV Type III",
"MixGauss1", "Mix1d", "MixGauss2", "MixGauss3",
"Bimodal", "Separated bimodal", "Skewed bimodal",
"Trimodal", "Smooth comb", "Claw")
models_to_run = c("DDFS", "Botev")
Ns <- N <- c(10^4)
examples <- ex <- c("Spliced2")
for (ex in examples) {
for (N in Ns) {
file_path <- file.path(getwd(), paste0("examples - Cui et al. (2020)/hpc/data/N=", N,"/X_", ex,".csv"))
X_df <- read.csv(file_path)
file_path <- file.path(getwd(), paste0("examples - Cui et al. (2020)/hpc/data/N=", N,"/pdf_X_", ex,".csv"))
f_X_df <- read.csv(file_path)
file_path <- file.path(getwd(), paste0("examples - Cui et al. (2020)/hpc/data/N=", N,"/cdf_X_", ex,".csv"))
F_X_df <- read.csv(file_path)
file_path <- file.path(getwd(), paste0("examples - Cui et al. (2020)/hpc/data/N=", N,"/X_new_", ex,".csv"))
X_new_df <- read.csv(file_path)
file_path <- file.path(getwd(), paste0("examples - Cui et al. (2020)/hpc/data/N=", N,"/pdf_X_new_", ex,".csv"))
f_X_new_df <- read.csv(file_path)
file_path <- file.path(getwd(), paste0("examples - Cui et al. (2020)/hpc/data/N=", N,"/cdf_X_new_", ex,".csv"))
F_X_new_df <- read.csv(file_path)
output <- paste0("output/N=", N)
run_models <- function(i, models_to_run = c("DDFS", "kernel", "Botev", "logspline", "lpdensity")) {
sim <- sim.dist(N, ex)
X <- sim$X; f_X <- sim$f_X; F_X <- sim$F_X
X_new <- seq(from = min(X), to = max(X), length.out = 1000)
f_X_new <- sim$f_X_func(X_new)
# X <- X_df[,i]; f_X <- f_X_df[,i]; F_X <- F_X_df[,i]
# X_new <- X_new_df[,i]; f_X_new <- f_X_new_df[,i]
f2 <- diff(diff(f_X_new))
f2_sign <- sign(f2)
roughness_pdf <- sum(diff(f2_sign) != 0)
result <- list(
# DDFS
MSE_DDFS_pdf = NULL, MAE_DDFS_pdf = NULL, ISE_DDFS_pdf = NULL, IAE_DDFS_pdf = NULL,
n_intknots_DDFS = NULL, roughness_DDFS_pdf = NULL,
time_DDFS = NULL, f_hat_DDFS = NULL, f_pred_DDFS = NULL,
MSE_DDFS_cdf = NULL, MAE_DDFS_cdf = NULL, F_hat_DDFS = NULL, F_pred_DDFS = NULL,
roughness_DDFS_cdf = NULL,
# kernel
MSE_kernel_pdf = NULL, MAE_kernel_pdf = NULL, ISE_kernel_pdf = NULL, IAE_kernel_pdf = NULL,
n_intknots_kernel = NULL, roughness_kernel_pdf = NULL,
time_kernel = NULL, f_hat_kernel = NULL, f_pred_kernel = NULL,
MSE_kernel_cdf = NULL, MAE_kernel_cdf = NULL, F_hat_kernel = NULL, F_pred_kernel = NULL,
roughness_kernel_cdf = NULL,
# Botev
MSE_Botev_pdf = NULL, MAE_Botev_pdf = NULL, ISE_Botev_pdf = NULL, IAE_Botev_pdf = NULL,
n_intknots_Botev = NULL, roughness_Botev_pdf = NULL,
time_Botev = NULL, f_hat_Botev = NULL, f_pred_Botev = NULL,
MSE_Botev_cdf = NULL, MAE_Botev_cdf = NULL, F_hat_Botev = NULL, F_pred_Botev = NULL,
roughness_Botev_cdf = NULL,
# logspline
MSE_logspline_pdf = NULL, MAE_logspline_pdf = NULL, ISE_logspline_pdf = NULL, IAE_logspline_pdf = NULL,
n_intknots_logspline = NULL, roughness_logspline_pdf = NULL,
time_logspline = NULL, f_hat_logspline = NULL, f_pred_logspline = NULL,
MSE_logspline_cdf = NULL, MAE_logspline_cdf = NULL, F_hat_logspline = NULL, F_pred_logspline = NULL,
roughness_logspline_cdf = NULL,
# lpdensity
MSE_lpdensity_pdf = NULL, MAE_lpdensity_pdf = NULL, ISE_lpdensity_pdf = NULL, IAE_lpdensity_pdf = NULL,
n_intknots_lpdensity = NULL, roughness_lpdensity_pdf = NULL,
time_lpdensity = NULL, f_hat_lpdensity = NULL, f_pred_lpdensity = NULL,
MSE_lpdensity_cdf = NULL, MAE_lpdensity_cdf = NULL, F_hat_lpdensity = NULL, F_pred_lpdensity = NULL,
roughness_lpdensity_cdf = NULL
)
# (I) DDFS
if ("DDFS" %in% models_to_run) {
##################################
# if (features(X)$outliers > 0.04*N && features(X)$kurt > 8) {
#   params <- choose_params(X = X, type = "default_top_mean_Q3")
# } else {
#   params <- choose_params(X = X, type = "bw_top_mean_Q3")
# }
params <- choose_params(X = X, type = "bw_top_mean_Q3")
start_time <- Sys.time()
ddfs_fit <- tryCatch(
ddfs(X, n = 4, min.intknots = 15,
phi_F = 0.9,
q_F = 2, beta = 0.9, tail_decay = "none"),
error = function(e) {
message(paste0("Error occurred in DDFS for iteration = ", i, ": ", e))
return(NULL)
}
)
if (i == 100) print(ddfs_fit$f_X_hat$knots)
# debugonce(UnivariateDensityFitter)
# ddfs_fit <- ddfs(X, n = 4, min.intknots = params$min.intknots,
#      phi_F = params$phi_F,
#      q_F = params$q_F, beta = params$beta, enforce_tail_decay = TRUE)
# plot.ddfs(ddfs_fit, fit = "pdf", f = sim$f_X_func)
# # For plotting
# mod <- ddfs(X, n = 4, min.intknots = min.intknots, phi_F = 0.3, q_F = 1, beta = beta,
#             plot = TRUE, pdf = sim$f_X_func, cdf = sim$F_X_func )
if(!is.null(ddfs_fit)){
# PDF
f_hat_DDFS <- ddfs_fit$f_X_hat$pred
result$f_hat_DDFS <- f_hat_DDFS
result$MSE_DDFS_pdf <- mean((f_X - f_hat_DDFS)^2)
result$MAE_DDFS_pdf <- mean(abs(f_X - f_hat_DDFS))
result$n_intknots_DDFS <- length(ddfs_fit$f_X_hat$knots) - ddfs_fit$f_X_hat$order*2
f_pred_DDFS <- as.numeric(predict.ddfs(ddfs_fit, newdata = X_new, type = "density"))
result$f_pred_DDFS <- f_pred_DDFS
result$ISE_DDFS_pdf <- mean((f_X_new - f_pred_DDFS)^2)
result$IAE_DDFS_pdf <- mean(abs(f_X_new - f_pred_DDFS))
# result$roughness_DDFS_pdf <- roughness_numeric(X_new, result$f_pred_DDFS)
f2 <- diff(diff(result$f_pred_DDFS))
f2_sign <- sign(f2)
result$roughness_DDFS_pdf <- sum(diff(f2_sign) != 0)
# CDF
F_hat_DDFS <- ddfs_fit$F_X_hat$pred
result$F_hat_DDFS <- F_hat_DDFS
result$MSE_DDFS_cdf <- mean((F_X - F_hat_DDFS)^2)
result$MAE_DDFS_cdf <- mean(abs(F_X - F_hat_DDFS))
result$F_pred_DDFS <- as.numeric(predict.ddfs(ddfs_fit, newdata = X_new, type = "distribution"))
result$roughness_DDFS_cdf <- roughness_numeric(X_new, result$F_pred_DDFS)
}
end_time <- Sys.time()
result$time_DDFS <- difftime(end_time, start_time, units = "secs")
}
# (II) kernel
if ("kernel" %in% models_to_run) {
start_time <- Sys.time()
kernel_fit <- tryCatch(
density(X, bw = "SJ", kernel = "optcosine"),
error = function(e) {
message(paste0("Error occurred in kernel for iteration = ", i, ": ", e))
return(NULL)
}
)
if(!is.null(kernel_fit)){
# PDF
f_hat_kernel <- approx(x = kernel_fit$x, y = kernel_fit$y, xout = X)$y
result$f_hat_kernel <- f_hat_kernel
result$MSE_kernel_pdf <- mean((f_X - f_hat_kernel)^2)
result$MAE_kernel_pdf <- mean(abs(f_X - f_hat_kernel))
f_pred_kernel <- as.numeric(approx(x = kernel_fit$x, y = kernel_fit$y, xout = X_new)$y)
result$f_pred_kernel <- f_pred_kernel
result$ISE_kernel_pdf <- mean((f_X_new - f_pred_kernel)^2)
result$IAE_kernel_pdf <- mean(abs(f_X_new - f_pred_kernel))
result$roughness_kernel_pdf <- roughness_numeric(X_new, result$f_pred_kernel)
# CDF
kernelCDF <- CDF(kernel_fit)
F_hat_kernel <- kernelCDF(X)
result$F_hat_kernel <- F_hat_kernel
result$MSE_kernel_cdf <- mean((F_X - F_hat_kernel)^2)
result$MAE_kernel_cdf <- mean(abs(F_X - F_hat_kernel))
result$F_pred_kernel <- kernelCDF(X_new)
result$roughness_kernel_cdf <- roughness_numeric(X_new, result$F_pred_kernel)
}
end_time <- Sys.time()
result$time_kernel <- difftime(end_time, start_time, units = "secs")
}
# (II) Botev
if ("Botev" %in% models_to_run) {
start_time <- Sys.time()
Botev_fit <- kde(X)
Botev_fit <- list(x = Botev_fit[1,], y = Botev_fit[2,])
if(!is.null(Botev_fit)){
# PDF
f_hat_Botev <- approx(x = Botev_fit$x, y = Botev_fit$y, xout = X)$y
result$f_hat_Botev <- f_hat_Botev
result$MSE_Botev_pdf <- mean((f_X - f_hat_Botev)^2)
result$MAE_Botev_pdf <- mean(abs(f_X - f_hat_Botev))
f_pred_Botev <- as.numeric(approx(x = Botev_fit$x, y = Botev_fit$y, xout = X_new)$y)
result$f_pred_Botev <- f_pred_Botev
result$ISE_Botev_pdf <- mean((f_X_new - f_pred_Botev)^2)
result$IAE_Botev_pdf <- mean(abs(f_X_new - f_pred_Botev))
# result$roughness_Botev_pdf <- roughness_numeric(X_new, result$f_pred_Botev)
f2 <- diff(diff(result$f_pred_Botev))
f2_sign <- sign(f2)
result$roughness_Botev_pdf <- sum(diff(f2_sign) != 0)
}
end_time <- Sys.time()
result$time_Botev <- difftime(end_time, start_time, units = "secs")
}
# (III) logspline
if ("logspline" %in% models_to_run) {
start_time <- Sys.time()
logspline_fit <- tryCatch(
logspline(X),
error = function(e) {
message(paste0("Error occurred in logspline for iteration = ", i, ": ", e))
return(NULL)
}
)
if(!is.null(logspline_fit)){
# PDF
f_hat_logspline <- dlogspline(X, logspline_fit)
result$f_hat_logspline <- f_hat_logspline
result$MSE_logspline_pdf <- mean((f_X - f_hat_logspline)^2)
result$MAE_logspline_pdf <- mean(abs(f_X - f_hat_logspline))
f_pred_logspline <- as.numeric(dlogspline(X_new, logspline_fit))
result$f_pred_logspline <- f_pred_logspline
result$ISE_logspline_pdf <- mean((f_X_new - f_pred_logspline)^2)
result$IAE_logspline_pdf <- mean(abs(f_X_new - f_pred_logspline))
result$roughness_logspline_pdf <- roughness_numeric(X_new, result$f_pred_logspline)
# CDF
F_hat_logspline <- plogspline(X, logspline_fit)
result$F_hat_logspline <- F_hat_logspline
result$MSE_logspline_cdf <- mean((F_X - F_hat_logspline)^2)
result$MAE_logspline_cdf <- mean(abs(F_X - F_hat_logspline))
result$F_pred_logspline <- plogspline(X_new, logspline_fit)
result$roughness_logspline_cdf <- roughness_numeric(X_new, result$F_pred_logspline)
}
end_time <- Sys.time()
result$time_logspline <- difftime(end_time, start_time, units = "secs")
}
# (IV) lpdensity
if ("lpdensity" %in% models_to_run) {
start_time <- Sys.time()
lpdensity_fit <- tryCatch(
lpdensity(data = X, grid = X,  bwselect = "imse-dpi"),
error = function(e) {
message(paste0("Error occurred in lpdensity for iteration = ", i, ": ", e))
return(NULL)
}
)
if(!is.null(lpdensity_fit)){
# PDF
f_hat_lpdensity <- as.numeric(lpdensity_fit$Estimate[, "f_p"])
result$f_hat_lpdensity <- f_hat_lpdensity
result$MSE_lpdensity_pdf <- mean((f_X - f_hat_lpdensity)^2)
result$MAE_lpdensity_pdf <- mean(abs(f_X - f_hat_lpdensity))
f_pred_lpdensity <- as.numeric(lpdensity(data = X, grid = X_new,  bwselect = "imse-dpi")$Estimate[,"f_p"])
result$f_pred_lpdensity <- f_pred_lpdensity
result$ISE_lpdensity_pdf <- mean((f_X_new - f_pred_lpdensity)^2)
result$IAE_lpdensity_pdf <- mean(abs(f_X_new - f_pred_lpdensity))
result$roughness_pdf <- roughness_numeric(X_new, result$f_pred_lpdensity)
# CDF
F_hat_lpdensity <- as.numeric(lpdensity(data = X, grid = X, v = 0, bwselect = "imse-dpi")$Estimate[,"f_p"])
result$F_hat_lpdensity <- F_hat_lpdensity
result$MSE_lpdensity_cdf <- mean((F_X - F_hat_lpdensity)^2)
result$MAE_lpdensity_cdf <- mean(abs(F_X - F_hat_lpdensity))
result$F_pred_lpdensity <- as.numeric(lpdensity(data = X, grid = X_new, v = 0, bwselect = "imse-dpi")$Estimate[,"f_p"])
esult$roughness_cdf <- roughness_numeric(X_new, result$F_pred_lpdensity)
}
end_time <- Sys.time()
result$time_lpdensity <- difftime(end_time, start_time, units = "secs")
}
# # PLOT
# plot.ddfs(ddfs_fit, fit = "pdf", f = sim$f_X_func, xlim = c(0,20))
# # lines(X_new, f_pred_kernel, lwd = 2 , col = "blue")
# lines(X_new, f_pred_Botev, lwd = 2 , col = "blue")
# # Add text inside the plot
# text(x = par("usr")[1] + 0.05 * diff(par("usr")[1:2]),   # left margin + 5%
#      y = par("usr")[4] - 0.05 * diff(par("usr")[3:4]),   # top margin - 5%
#      labels = paste0("Roughness DDFS: ", round(result$roughness_DDFS_pdf, 4)),
#      adj = 0)
#
# text(x = par("usr")[1] + 0.05 * diff(par("usr")[1:2]),
#      y = par("usr")[4] - 0.10 * diff(par("usr")[3:4]),
#      labels = paste0("Roughness Botev: ", round(result$roughness_Botev_pdf, 4)),
#      adj = 0)
return(result)
}
runs <- 100
# Set a seed for reproducibility
set.seed(123)
# Get the number of cores
# n_cores <- as.numeric(Sys.getenv("SLURM_CPUS_PER_TASK"))
# Run the cross-validations in parallel
# results <- mclapply(1:runs, function(i) run_models(i), mc.cores = n_cores)
results <- lapply(1:runs, function(i) run_models(i, models_to_run))
###############################
####### Extract Results #######
###############################
# (I) DDFS
MSE_DDFS_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$MSE_DDFS_pdf)) res$MSE_DDFS_pdf else NA
)
MAE_DDFS_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$MAE_DDFS_pdf)) res$MAE_DDFS_pdf else NA
)
ISE_DDFS_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$ISE_DDFS_pdf)) res$ISE_DDFS_pdf else NA
)
IAE_DDFS_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$IAE_DDFS_pdf)) res$IAE_DDFS_pdf else NA
)
roughness_DDFS_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$roughness_DDFS_pdf)) res$roughness_DDFS_pdf else NA
)
MSE_DDFS_cdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$MSE_DDFS_cdf)) res$MSE_DDFS_cdf else NA
)
MAE_DDFS_cdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$MAE_DDFS_cdf)) res$MAE_DDFS_cdf else NA
)
roughness_DDFS_cdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$roughness_DDFS_cdf)) res$roughness_DDFS_cdf else NA
)
n_intknots_DDFS <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$n_intknots_DDFS)) res$n_intknots_DDFS else NA
)
time_DDFS <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$time_DDFS)) res$time_DDFS else NA
)
# (II) kernel
MSE_kernel_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$MSE_kernel_pdf)) res$MSE_kernel_pdf else NA
)
MAE_kernel_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$MAE_kernel_pdf)) res$MAE_kernel_pdf else NA
)
ISE_kernel_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$ISE_kernel_pdf)) res$ISE_kernel_pdf else NA
)
IAE_kernel_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$IAE_kernel_pdf)) res$IAE_kernel_pdf else NA
)
roughness_kernel_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$roughness_kernel_pdf)) res$roughness_kernel_pdf else NA
)
MSE_kernel_cdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$MSE_kernel_cdf)) res$MSE_kernel_cdf else NA
)
MAE_kernel_cdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$MAE_kernel_cdf)) res$MAE_kernel_cdf else NA
)
roughness_kernel_cdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$roughness_kernel_cdf)) res$roughness_kernel_cdf else NA
)
n_intknots_kernel <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$n_intknots_kernel)) res$n_intknots_kernel else NA
)
time_kernel <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$time_kernel)) res$time_kernel else NA
)
# (II) Botev
MSE_Botev_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$MSE_Botev_pdf)) res$MSE_Botev_pdf else NA
)
MAE_Botev_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$MAE_Botev_pdf)) res$MAE_Botev_pdf else NA
)
ISE_Botev_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$ISE_Botev_pdf)) res$ISE_Botev_pdf else NA
)
IAE_Botev_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$IAE_Botev_pdf)) res$IAE_Botev_pdf else NA
)
roughness_Botev_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$roughness_Botev_pdf)) res$roughness_Botev_pdf else NA
)
MSE_Botev_cdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$MSE_Botev_cdf)) res$MSE_Botev_cdf else NA
)
MAE_Botev_cdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$MAE_Botev_cdf)) res$MAE_Botev_cdf else NA
)
roughness_Botev_cdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$roughness_Botev_cdf)) res$roughness_Botev_cdf else NA
)
n_intknots_Botev <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$n_intknots_Botev)) res$n_intknots_Botev else NA
)
time_Botev <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$time_Botev)) res$time_Botev else NA
)
# (III) logspline
MSE_logspline_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$MSE_logspline_pdf)) res$MSE_logspline_pdf else NA
)
MAE_logspline_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$MAE_logspline_pdf)) res$MAE_logspline_pdf else NA
)
ISE_logspline_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$ISE_logspline_pdf)) res$ISE_logspline_pdf else NA
)
IAE_logspline_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$IAE_logspline_pdf)) res$IAE_logspline_pdf else NA
)
roughness_logspline_pdf <- sapply(results, function(res)
if(!is.null(res) && !is.null(res$roughness_logspline_pdf)) res$roughness_logspline_pdf else NA
)
