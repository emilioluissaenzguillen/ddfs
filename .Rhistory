}
# Set once
t_max <- max(t_values)
# Define inputs for each group
inputs <- list(
base   = list(Z = ddfs[["ddfs_Z"]],         XZ = ddfs[["ddfs_XZ"]],         erosion = erosion),
poorer = list(Z = ddfs[["ddfs_Z_poorer"]],  XZ = ddfs[["ddfs_XZ_poorer"]],  erosion = erosion_poorer),
richer = list(Z = ddfs[["ddfs_Z_richer"]],  XZ = ddfs[["ddfs_XZ_richer"]],  erosion = erosion_richer)
)
# Compute in one pass
params <- lapply(inputs, function(x) compute_params(x$Z, x$XZ, x$erosion, t_max))
## 1.2. z(t) = z/ζ(t)
calculate_z_values <- function(c_param, d, t_values) {
t_max   <- max(t_values)
t_med   <- median(t_values)
exp_neg <- exp(-d * t_values)
dec_vec <- c_param * exp_neg
inc_vec <- c_param * exp(-d * t_max) + c_param * (1 - exp_neg)
dec_inc <- ifelse(t_values <= t_med,
dec_vec,
c_param * exp(-d * t_med) * exp(d * (t_values - t_med)))
list(
increasing_z            = inc_vec,
decreasing_z            = dec_vec,
decreasing_increasing_z = dec_inc
)
}
z_values        <- calculate_z_values(params$base$c, params$base$d, t_values)
z_values_poorer <- calculate_z_values(params$poorer$c, params$poorer$d, t_values)
z_values_richer <- calculate_z_values(params$richer$c, params$richer$d, t_values)
## 1.3. F_Z(z(t))
F_Z_z_t <- lapply(z_values, function(z_vals)
ddfs:::predict.ddfs(ddfs[["ddfs_Z"]], newdata = z_vals, type = "distribution")
)
F_Z_z_t_poorer <- lapply(z_values_poorer, function(z_vals)
ddfs:::predict.ddfs(ddfs[["ddfs_Z_poorer"]], newdata = z_vals, type = "distribution")
)
F_Z_z_t_richer <- lapply(z_values_richer, function(z_vals)
ddfs:::predict.ddfs(ddfs[["ddfs_Z_richer"]], newdata = z_vals, type = "distribution")
)
#########################
## 2. F_X_Z(p(t),z(t)) ##
#########################
## U-vectors for X
U_list_X <- list(
base   = as.numeric(res_X$F_X_p_t),
poorer = as.numeric(res_X$F_X_p_t_poorer),
richer = as.numeric(res_X$F_X_p_t_richer)
)
## U-vectors for X_tilde  (rename if your objects are different)
U_list_X_tilde <- list(
base   = as.numeric(res_X_tilde$F_X_p_t),
poorer = as.numeric(res_X_tilde$F_X_p_t_poorer),
richer = as.numeric(res_X_tilde$F_X_p_t_richer)
)
## Match the F_Z(z(t)) lists
FZ_list <- list(
base   = F_Z_z_t,
poorer = F_Z_z_t_poorer,
richer = F_Z_z_t_richer
)
## ---- Copula fits ---------------------------------------------------------
## X ~ Z
cop_files_X <- c(
base   = "lorenz_curves&copula/rds/X/IFMfitn_X_Z.rds",
poorer = "lorenz_curves&copula/rds/X/IFMfitn_X_Z_poorer.rds",
richer = "lorenz_curves&copula/rds/X/IFMfitn_X_Z_richer.rds"
)
cop_X <- lapply(cop_files_X, readRDS)
## X_tilde ~ Z   (adjust paths if different in your repo)
cop_files_X_tilde <- c(
base   = "lorenz_curves&copula/rds/X_tilde/IFMfitn_X_tilde_Z.rds",
poorer = "lorenz_curves&copula/rds/X_tilde/IFMfitn_X_tilde_Z_poorer.rds",
richer = "lorenz_curves&copula/rds/X_tilde/IFMfitn_X_tilde_Z_richer.rds"
)
cop_X_tilde <- lapply(cop_files_X_tilde, readRDS)
## ---- Compute C(U, V) per group (base/poorer/richer) and per z-scenario ---
## Result is a nested list like: $base$increasing_z (numeric vector), etc.
F_XZ_pz <- mapply(function(U, FZ, fit) {
lapply(FZ, function(V) {
stopifnot(length(V) == length(U))
pCopula(cbind(U, V), fit@copula)
})
}, U_list_X, FZ_list, cop_X, SIMPLIFY = FALSE)
F_X_tildeZ_pz <- mapply(function(U, FZ, fit) {
lapply(FZ, function(V) {
stopifnot(length(V) == length(U))
pCopula(cbind(U, V), fit@copula)
})
}, U_list_X_tilde, FZ_list, cop_X_tilde, SIMPLIFY = FALSE)
########################################################################################
## 3. F_{\tilde{T}}(t) = 1-F_{\tilde{X}}(p(t))-F_{Z}(z(t))+F_{\tilde{X},Z}(p(t),z(t)) ##
########################################################################################
F_T_c <- Map(function(Ux, FZ_group, FXZ_group) {
out <- Map(function(Fz, Fxz) 1 - Ux - Fz + Fxz, FZ_group, FXZ_group)
if (!is.null(names(FZ_group))) names(out) <- names(FZ_group)
out
}, U_list_X, FZ_list, F_XZ_pz)
F_T_tilde_c <- Map(function(Ut, FZ_group, FXtZ_group) {
out <- Map(function(Fz, Fxz) 1 - Ut - Fz + Fxz, FZ_group, FXtZ_group)
if (!is.null(names(FZ_group))) names(out) <- names(FZ_group)
out
}, U_list_X_tilde, FZ_list, F_X_tildeZ_pz)
######################################################################
#------------------------------- PLOT -------------------------------#
######################################################################
scenarios <- c("decreasing_z", "increasing_z", "decreasing_increasing_z")
for (s in scenarios) {
# vectors for this scenario
F_T <- F_T_c$base[[s]]
F_T_poorer <- F_T_c$poorer[[s]]
F_T_richer <- F_T_c$richer[[s]]
F_T_tilde        <- F_T_tilde_c$base[[s]]
F_T_tilde_poorer <- F_T_tilde_c$poorer[[s]]
F_T_tilde_richer <- F_T_tilde_c$richer[[s]]
# y-limits (include DDFS overlays if present and named the same way)
y_rng <- range(c(
F_T, F_T_tilde, F_T_tilde_poorer, F_T_tilde_richer,
F_T_poorer, F_T_richer,
if (exists("F_T_c_ddfs"))           F_T_c_ddfs[[s]]           else NULL,
if (exists("F_T_c_poorer_ddfs"))    F_T_c_poorer_ddfs[[s]]    else NULL,
if (exists("F_T_c_richer_ddfs"))    F_T_c_richer_ddfs[[s]]    else NULL
), na.rm = TRUE)
par(mar = c(5, 5, 1, 2) + 0.1)
plot(t_values, F_T_tilde,
ylim = y_rng,
ylab = expression(F[T[c]](t) ~ "/" ~ F[tilde(T)[c]](t)),
xlab = "Time to purchase (t)",
lwd = 2, type = "l", col = "red", cex.lab = 1.5, cex.axis = 1.5)
lines(t_values, F_T, lwd = 2, lty = 1, col = "red")
lines(t_values, F_T_poorer, lwd = 2, lty = 2, col = "red")
lines(t_values, F_T_richer, lwd = 2, lty = 3, col = "red")
lines(t_values, F_T_tilde_poorer, lwd = 2, lty = 2, col = "blue")
lines(t_values, F_T_tilde_richer, lwd = 2, lty = 3, col = "blue")
# # --- optional DDFS overlays in red (if available) ---
# if (exists("F_T_c_ddfs"))        lines(t_values, F_T_c_ddfs[[s]],        lwd = 2, lty = 1, col = "red")
# if (exists("F_T_c_poorer_ddfs")) lines(t_values, F_T_c_poorer_ddfs[[s]], lwd = 2, lty = 2, col = "red")
# if (exists("F_T_c_richer_ddfs")) lines(t_values, F_T_c_richer_ddfs[[s]], lwd = 2, lty = 3, col = "red")
# ## top row: red/blue squares side-by-side
# legend("bottomright",
#        legend = c(expression(X), expression(tilde(X))),
#        pch = 15,
#        col = c("red", "blue"),
#        horiz = TRUE,
#        bty = "n",
#        cex = 1.25,
#        inset = c(0.05, 0.225))
## bottom block: your line styles
legend("bottomright",
legend = c(
"Total",
expression(1^{st} ~ quart.),
expression(4^{th} ~ quart.)
),
lty = c(1, 2, 3),
lwd = 2,
col = "blue",
bty = "n",
cex = 1.25,
y.intersp = 1.5)
par(mar = c(5, 4, 4, 2) + 0.1)
# Save the plot
dev.copy(png, file = file.path(output, paste0("/F_T_c_joint_", s, ".png")), width=2600, height=1800, res=300)
dev.off()
}
